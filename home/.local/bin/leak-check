#!/usr/bin/env python3
"""Block private GitHub repository names from reaching public repositories.

Modes:
  leak-check [--visibility] OWNER/REPO [FILE ...]  Check stdin/files (or report visibility)
  leak-check --pre-push REMOTE URL                 Git pre-push hook mode
  leak-check --claude-hook                         Claude Code PreToolUse Bash hook mode

Set LEAK_CHECK_SKIP=1 to bypass the check (prints a notice to stderr).
"""

import argparse
import json
import os
import re
import shlex
import stat
import subprocess
import sys
import time
import urllib.parse

CACHE_TTL = 24 * 60 * 60
GH_TIMEOUT = 30
MAX_FILE_BYTES = 1024 * 1024
GITHUB_HOSTS = {"github.com", "ssh.github.com"}
REPO_PART = r"[A-Za-z0-9._-]+"
REPO_PART_RE = re.compile(rf"^{REPO_PART}$")
ZERO_OID_RE = re.compile(r"^0+$")
GH_CMD_RE = re.compile(r"\bgh\b")
GH_AREA_RE = re.compile(r"\b(?:pr|issue|release|api)\b")
REPO_FLAG_RE = re.compile(r"(?:^|\s)(?:-R|--repo)(?:=|\s+)['\"]?([^\s'\"`;&|()]+)")
API_REPO_RE = re.compile(rf"(?:https?://api\.github\.com)?/?repos/({REPO_PART})/({REPO_PART})", re.IGNORECASE)
GH_URL_RE = re.compile(rf"https?://github\.com/({REPO_PART})/({REPO_PART})", re.IGNORECASE)


class LeakCheckError(Exception):
    """Fail-closed error (gh failure, unreadable file, invalid input)."""


def skip_enabled():
    if os.environ.get("LEAK_CHECK_SKIP") == "1":
        print("leak-check: skipped (LEAK_CHECK_SKIP=1)", file=sys.stderr)
        return True
    return False


def valid_repo(owner, name):
    name = name[:-4] if name.endswith(".git") else name
    if owner in ("", ".", "..") or name in ("", ".", ".."):
        return None
    return (owner, name) if REPO_PART_RE.match(owner) and REPO_PART_RE.match(name) else None


def parse_github_remote(url):
    url = (url or "").strip()
    if "://" not in url:
        m = re.match(r"^(?:[^@/\s]+@)?([^:/\s]+):/?([^/\s]+)/([^/\s]+?)/?$", url)
        return valid_repo(m.group(2), m.group(3)) if m and m.group(1).lower() in GITHUB_HOSTS else None
    p = urllib.parse.urlparse(url)
    parts = [s for s in p.path.split("/") if s]
    return valid_repo(parts[0], parts[1]) if (p.hostname or "").lower() in GITHUB_HOSTS and len(parts) == 2 else None


def parse_repo_spec(spec):
    spec = (spec or "").strip()
    if "://" in spec:
        m = GH_URL_RE.match(spec)
        return parse_github_remote(spec) or (valid_repo(m.group(1), m.group(2)) if m else None)
    parts = [s for s in spec.strip("/").split("/") if s]
    if len(parts) == 3 and parts[0].lower() in GITHUB_HOSTS:
        return valid_repo(parts[1], parts[2])
    return valid_repo(parts[0], parts[1]) if len(parts) == 2 else None


def xdg_file(env_var, default_dir, *parts):
    return os.path.join(os.environ.get(env_var) or os.path.join(os.path.expanduser("~"), default_dir), *parts)


def cache_get(key):
    try:
        with open(xdg_file("XDG_CACHE_HOME", ".cache", "leak-check", f"{key}.json"), encoding="utf-8") as f:
            data = json.load(f)
        if 0 <= time.time() - float(data["fetched_at"]) < CACHE_TTL:
            return True, data["value"]
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return False, None


def cache_set(key, value):
    directory = xdg_file("XDG_CACHE_HOME", ".cache", "leak-check")
    try:
        os.makedirs(directory, mode=0o700, exist_ok=True)
        path = os.path.join(directory, f"{key}.json")
        tmp = f"{path}.{os.getpid()}.tmp"
        # Restrict permissions because the cache holds private repository names.
        with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as f:
            json.dump({"fetched_at": time.time(), "value": value}, f)
        os.replace(tmp, path)
    except OSError:
        pass


def run_gh(args):
    try:
        r = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=GH_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as err:
        raise LeakCheckError(f"gh failed ({err}); set LEAK_CHECK_SKIP=1 to override") from err
    if r.returncode != 0:
        detail = (r.stderr or r.stdout or f"exit {r.returncode}").strip()
        raise LeakCheckError(f"gh {' '.join(args[:3])} failed: {detail} (set LEAK_CHECK_SKIP=1 to override)")
    return r.stdout


def get_visibility(owner, name):
    key = f"visibility--{owner.lower()}--{name.lower()}"
    hit, val = cache_get(key)
    if hit and isinstance(val, str) and val:
        return val
    vis = run_gh(["api", f"repos/{owner}/{name}", "-q", ".visibility"]).strip().lower()
    if vis not in ("public", "private", "internal"):
        raise LeakCheckError(f"unexpected visibility {vis!r} for {owner}/{name} (set LEAK_CHECK_SKIP=1 to override)")
    cache_set(key, vis)
    return vis


def get_terms(owner):
    key = f"private--{owner.lower()}"
    hit, names = cache_get(key)
    if not (hit and isinstance(names, list)):
        out = run_gh(["repo", "list", owner, "--visibility", "private", "--limit", "1000", "--json", "name", "-q", ".[].name"])
        names = [line.strip() for line in out.splitlines() if line.strip()]
        cache_set(key, names)
    extra, ignored = [], set()
    terms_path = xdg_file("XDG_CONFIG_HOME", ".config", "leak-check", "terms")
    try:
        with open(terms_path, encoding="utf-8") as f:
            for line in f:
                term = line.strip()
                if term and not term.startswith("#"):
                    (ignored.add(term[1:].strip().lower()) if term.startswith("!") else extra.append(term))
    except FileNotFoundError:
        pass
    except OSError as err:
        raise LeakCheckError(f"cannot read {terms_path}: {err} (set LEAK_CHECK_SKIP=1 to override)") from err
    seen = {}
    for term in [*names, *extra]:
        if isinstance(term, str) and term and term.lower() not in ignored:
            seen.setdefault(term.lower(), term)
    return list(seen.values())


def find_hits(text, terms):
    """Case-insensitive match where non-alphanumerics (-, _, /, .) act as boundaries."""
    if not terms or not text:
        return []
    ordered = sorted(terms, key=len, reverse=True)
    # [^\W_] matches Unicode letters/digits only, so '-', '_', '/', '.' are boundaries.
    if not re.search(r"(?<![^\W_])(?:" + "|".join(re.escape(t) for t in ordered) + r")(?![^\W_])", text, re.IGNORECASE):
        return []
    return [t for t in ordered if re.search(r"(?<![^\W_])" + re.escape(t) + r"(?![^\W_])", text, re.IGNORECASE)]


def read_regular_file(path, max_bytes=None):
    """Read a regular file without hanging on FIFOs; returns None if non-regular or over max_bytes."""
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or (max_bytes is not None and st.st_size > max_bytes):
            return None
        os.set_blocking(fd, True)
        with os.fdopen(fd, "rb") as f:
            fd = -1
            return f.read().decode("utf-8", errors="replace")
    finally:
        if fd >= 0:
            os.close(fd)


def scan_repo(owner, name, sources):
    if get_visibility(owner, name) != "public":
        return False
    terms, blocked = get_terms(owner), False
    for label, text in sources:
        hits = find_hits(text, terms)
        if hits:
            print(f"leak-check: blocked for public repo {owner}/{name}: [{', '.join(hits)}] in {label}", file=sys.stderr)
            blocked = True
    return blocked


def run_git(args, stdin_text=None):
    r = subprocess.run(["git", *args], input=stdin_text.encode("utf-8") if stdin_text else None, capture_output=True)
    if r.returncode != 0:
        raise LeakCheckError(f"git {' '.join(args[:3])} failed: {r.stderr.decode('utf-8', errors='replace').strip()}")
    return r.stdout.decode("utf-8", errors="replace")


def extract_added_lines(patch):
    added, in_hunk, width = [], False, 1
    for line in patch.splitlines():
        if line.startswith("diff --git "):
            in_hunk = False
        elif line.startswith("@@") and (m := re.match(r"^(@{2,}) ", line)):
            in_hunk, width = True, len(m.group(1)) - 1
        elif in_hunk and not line.startswith("\\ No newline"):
            prefix = line[:width]
            if "+" in prefix and set(prefix) <= {"+", "-", " "}:
                added.append(line[width:])
    return "\n".join(added)


def run_pre_push(remote_url):
    if skip_enabled() or not (repo := parse_github_remote(remote_url)):
        return 0
    owner, name = repo
    local_oids, remote_oids = [], []
    for line in sys.stdin.read().splitlines():
        parts = line.split()
        if len(parts) < 4 or ZERO_OID_RE.match(parts[1]):
            continue
        local_oids.append(parts[1])
        if not ZERO_OID_RE.match(parts[3]) and subprocess.run(
            ["git", "cat-file", "-e", f"{parts[3]}^{{commit}}"], capture_output=True
        ).returncode == 0:
            remote_oids.append(parts[3])
    if not local_oids or get_visibility(owner, name) != "public":
        return 0
    commits = [c for c in run_git(["rev-list", *local_oids, "--not", "--remotes", *remote_oids]).splitlines() if c]
    if not commits:
        return 0
    # NUL-delimited header keeps commit messages unambiguous alongside the patch.
    tag = f"__LEAK_CHECK_{os.getpid()}__"
    raw = run_git(
        ["log", "--no-walk=unsorted", "--stdin", "-p", "--cc", "--unified=0",
         "--no-color", "--no-ext-diff", "--no-textconv", f"--format=%x00{tag}%x00%H%x00%B%x00"],
        "\n".join(commits) + "\n",
    )
    sources = []
    for chunk in raw.split(f"\x00{tag}\x00")[1:]:
        oid, msg, patch = (chunk.split("\x00", 2) + ["", ""])[:3]
        short = oid.strip()[:12]
        sources.extend([(f"commit {short} message", msg), (f"commit {short} added lines", extract_added_lines(patch))])
    return 1 if scan_repo(owner, name, sources) else 0


def find_command_repos(command, cwd):
    repos = []
    add = lambda r: r and r not in repos and repos.append(r)
    for raw in REPO_FLAG_RE.findall(command):
        add(parse_repo_spec(raw))
    for pat in (API_REPO_RE, GH_URL_RE):
        for m in pat.finditer(command):
            add(valid_repo(m.group(1), m.group(2)))
    if not repos:
        r = subprocess.run(["git", "-C", cwd, "remote", "-v"], capture_output=True, text=True)
        if r.returncode == 0:
            by_name = {p[0]: p[1] for line in r.stdout.splitlines() if len(p := line.split()) >= 2}
            for remote in ("origin", "upstream", *by_name):
                if parsed := parse_github_remote(by_name.get(remote, "")):
                    add(parsed)
                    break
    return repos


def extract_referenced_files(command, cwd):
    try:
        tokens = shlex.split(command)
    except ValueError:
        tokens = command.split()
    # Check both full shlex tokens (paths with spaces) and split pieces (inside sh -c / "$(cat f)").
    candidates = [p for tok in tokens for p in ([tok, *tok.split()] if any(c.isspace() for c in tok) else [tok])]
    seen, results = set(), []
    for raw in candidates:
        tok = raw.strip("'\"`(); \t\r\n")
        if tok.startswith("$("):
            tok = tok[2:].strip("'\"`(); \t\r\n")
        if "=" in tok:
            tok = tok.split("=", 1)[1].strip("'\"`();")
        path = tok.lstrip("<@").strip("'\"`();")
        if not path or path == "-":
            continue
        full = os.path.expanduser(path)
        full = full if os.path.isabs(full) else os.path.join(cwd, full)
        if full in seen:
            continue
        seen.add(full)
        try:
            text = read_regular_file(full, max_bytes=MAX_FILE_BYTES)
        except OSError:
            continue
        if text is not None:
            results.append((full, text))
    return results


def run_claude_hook():
    if skip_enabled():
        return 0
    try:
        payload = json.loads(sys.stdin.read())
    except ValueError as err:
        raise LeakCheckError(f"invalid hook JSON on stdin: {err}") from err
    if not isinstance(payload, dict):
        raise LeakCheckError("expected JSON object on stdin")
    if payload.get("tool_name") and payload["tool_name"] != "Bash":
        return 0
    tool_input = payload.get("tool_input")
    command = tool_input.get("command") if isinstance(tool_input, dict) else None
    if not isinstance(command, str) or not (GH_CMD_RE.search(command) and GH_AREA_RE.search(command)):
        return 0
    cwd = payload.get("cwd") or payload.get("working_directory") or os.getcwd()
    repos = find_command_repos(command, cwd)
    if not repos:
        return 0
    sources = [("command", command), *extract_referenced_files(command, cwd)]
    return 2 if any([scan_repo(o, n, sources) for o, n in repos]) else 0


def run_direct(repo_spec, files, visibility_only):
    repo = parse_repo_spec(repo_spec)
    if not repo:
        raise LeakCheckError(f"invalid GitHub repo {repo_spec!r}; expected OWNER/REPO")
    owner, name = repo
    if visibility_only:
        print(f"{owner}/{name}: {get_visibility(owner, name)}")
        return 0
    if skip_enabled():
        return 0
    sources = []
    for path in files or ["-"]:
        if path == "-":
            sources.append(("stdin", sys.stdin.read()))
        else:
            try:
                text = read_regular_file(path)
            except OSError as err:
                raise LeakCheckError(f"cannot read {path}: {err}") from err
            if text is None:
                raise LeakCheckError(f"not a regular file: {path}")
            sources.append((path, text))
    return 1 if scan_repo(owner, name, sources) else 0


def main():
    parser = argparse.ArgumentParser(description="Block private GitHub repo names from reaching public repos.")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--pre-push", action="store_true", help="Git pre-push hook mode")
    mode.add_argument("--claude-hook", action="store_true", help="Claude Code PreToolUse Bash hook mode")
    parser.add_argument("--visibility", action="store_true", help="Report repo visibility without scanning")
    parser.add_argument("args", nargs="*", help="OWNER/REPO [FILE ...] or pre-push REMOTE URL")
    parsed = parser.parse_args()
    try:
        if parsed.claude_hook:
            return run_claude_hook()
        if parsed.pre_push:
            return run_pre_push(parsed.args[1] if len(parsed.args) >= 2 else (parsed.args[0] if parsed.args else ""))
        if not parsed.args:
            parser.error("OWNER/REPO is required unless --pre-push or --claude-hook is set")
        return run_direct(parsed.args[0], parsed.args[1:], parsed.visibility)
    except LeakCheckError as err:
        print(f"leak-check: {err}", file=sys.stderr)
        # Claude Code blocks only on exit 2; other non-zero codes fail open.
        return 2 if parsed.claude_hook else 1


if __name__ == "__main__":
    sys.exit(main())
