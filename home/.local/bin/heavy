#!/usr/bin/env python3
"""Run a heavy job (a build, a test replay) on msi-dux when it answers, else on this machine.

COMMAND runs from the current directory through `bash -c`: one word is a shell
command line (`heavy -- 'cd lab && make'`), several are an argv (`heavy -- touch
"my file"`). On msi-dux it runs in a copy of the git worktree at the same
path (same home), uncommitted edits included, with the repo's common .git
mirrored alongside so worktree pointers and Nix resolve. msi-dux runs 3 jobs
at once, other machines 2; more wait for a slot. heavy prints its own `heavy:`
lines to stderr and exits with the job's status.
"""

import argparse
import fcntl
import hashlib
import secrets
import os
import shlex
import signal
import socket
import subprocess
import sys
import threading
import time

REMOTE = "abdulrahman@msi-dux"
REMOTE_NAME = REMOTE.rpartition("@")[2]
SSH = os.environ.get("HEAVY_SSH", "ssh")
CONNECT_TIMEOUT = 5  # seconds; also how long routing waits for msi-dux to answer
SSH_ARGS = [SSH, "-o", "BatchMode=yes", "-o", f"ConnectTimeout={CONNECT_TIMEOUT}"]
RSH = shlex.join(SSH_ARGS)  # rsync -e
LOCK_DIR = os.environ.get("HEAVY_LOCK_DIR", "/tmp/heavy")
REMOTE_SLOTS = 3
LOCAL_SLOTS = REMOTE_SLOTS if socket.gethostname() == REMOTE_NAME else 2
GRACE = 10  # seconds between SIGTERM and SIGKILL for the job's process group
FAILED = 255  # heavy's own failures; the job didn't run or its status was lost
# Starts the remote script's protocol lines on stderr. The per-run token keeps job
# output from passing for one.
MARK = f"\x1eheavy-{secrets.token_hex(8)} ".encode()

EPILOG = """\
routing:
  HEAVY_WHERE=local|remote forces a side; otherwise msi-dux if it answers ssh
  within 5 s. heavy started on msi-dux runs there. On a machine with AGENT_HEAVY_JOBS=deny, a local run needs
  --local-ok.

repo files (at the worktree root, both optional):
  .heavyignore    rsync exclude patterns for the copy (gitignore isn't used:
                  a job may need ignored files such as node_modules). Don't
                  exclude .git: a worktree copy needs its pointer.
  .heavy-cleanup  bash script run at the root after the job ends, even when
                  it was interrupted (for example, stop a database it started)

exit codes:
  the job's own status, unchanged; 128+N if heavy got signal N; 255 if heavy
  failed itself (see its heavy: lines) or lost the remote job; 2 bad arguments

To stop a job, send heavy (or its agent-wait group) TERM, INT or HUP: heavy kills
the job's process group, here or on msi-dux, then runs .heavy-cleanup. A KILL
leaves a local job running; a remote one still stops when its ssh pipe closes.
"""

# Fed to `bash -l -s` on msi-dux: its login shell is fish, which can't parse
# bash quoting, and -l loads the login PATH. Our stdin stays open after the
# script while local heavy lives, so EOF there means heavy was stopped or lost.
# The braces make bash read the whole script before it runs any of it; otherwise
# the watcher's cat would swallow the unread rest of the script from stdin.
REMOTE_SCRIPT = r"""{
set -m  # job control: the job gets its own process group, so one kill reaches all of it
mark() { printf '\036{mark} %s\n' "$*" >&2; }
stop() {
  stopped=1
  if [ -n "${pid:-}" ]; then
    kill -TERM -- "-$pid" 2>/dev/null
    # KILLs a leader that ignores TERM: the wait loop below can't end while it lives.
    (sleep {grace}; kill -KILL -- "-$pid" 2>/dev/null) 9>&- >/dev/null 2>&1 &
    timer=$!
  fi
}
trap stop TERM INT HUP
(cat >/dev/null; kill -TERM $$) >/dev/null 2>&1 &
watcher=$!
mkdir -p {lock_dir}
while [ -z "${stopped:-}" ]; do
  for slot in $(seq 1 {slots}); do
    # fd 9 holds the slot. Jobs get 9>&- so a daemon they start can't inherit it.
    exec 9>{lock_dir}/slot-$slot.lock
    flock -n 9 && break 2
  done
  exec 9>&-
  sleep 1
done
if [ -n "${stopped:-}" ]; then rc=143; else
  mark slot "$slot"
  (cd {cwd} && exec bash -c -- {command}) 9>&- </dev/null &
  pid=$!
  [ -n "${stopped:-}" ] && stop  # a stop that came between the check and the start
  while :; do
    wait "$pid"; rc=$?
    kill -0 "$pid" 2>/dev/null || break  # wait returned early for the trap
  done
  # TERM what the job left in its group, and KILL the group if anything outlives
  # GRACE: a survivor would also hold ssh's pipes open.
  kill -TERM -- "-$pid" 2>/dev/null
  for _ in $(seq {grace_tenths}); do kill -0 -- "-$pid" 2>/dev/null || break; sleep 0.1; done
  kill -KILL -- "-$pid" 2>/dev/null
  [ -n "${timer:-}" ] && kill -- "-$timer" 2>/dev/null
  mark job-done
  if [ -f {root}/.heavy-cleanup ]; then
    (cd {root} && bash .heavy-cleanup) 9>&- </dev/null || mark cleanup-failed $?
  fi
fi
kill -- "-$watcher" 2>/dev/null
mark exit "$rc"
exit "$rc"
}
"""

# Refuses to overwrite a directory heavy didn't create: msi-dux may hold a
# real checkout at the same path. heavy records its copies in a list there.
PREPARE_SCRIPT = r"""
list=~/.local/state/heavy/copies
mkdir -p ~/.local/state/heavy && touch "$list"
exec 8>>"$list" && flock 8  # one prepare at a time, so two first runs can't both claim a path
listed() { grep -qxF -- "$1" "$list"; }
# A path is heavy's if it's listed, lies inside a listed copy (a main checkout's
# .git, which its worktrees mirror), or holds nothing but heavy's paths (the
# directory a worktree's mirrored .git needed).
owned() {
  listed "$1" && return 0
  local up=$1 entry
  while [ "$up" != "${up%/*}" ]; do up=${up%/*}; listed "$up" && return 0; done
  [ -d "$1" ] && [ ! -L "$1" ] || return 1
  for entry in "$1"/* "$1"/.[!.]* "$1"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    owned "$entry" || return 1
  done
}
for dir in "$@"; do
  if [ -e "$dir" ] && ! owned "$dir"; then
    echo "heavy: $dir already exists on msi-dux and isn't a heavy copy; not overwriting it" >&2
    exit 1
  fi
  mkdir -p -- "$dir" && { listed "$dir" || printf '%s\n' "$dir" >> "$list"; }
done
"""

stop_signal = None


def say(message):
    print(f"heavy: {message}", file=sys.stderr, flush=True)


def git(*args):
    result = subprocess.run(["git", *args], capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else None


def lock_path(kind, key):
    os.makedirs(LOCK_DIR, exist_ok=True)
    return os.path.join(LOCK_DIR, f"{kind}-{hashlib.sha1(key.encode()).hexdigest()[:16]}.lock")


def acquire(path):
    """Block until we hold the lock; return its fd, or None if a signal came first.

    Python opens fds non-inheritable, so neither the job nor a daemon it starts
    can keep holding the lock after heavy exits.
    """
    fd = os.open(path, os.O_WRONLY | os.O_CREAT, 0o644)
    while stop_signal is None:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            time.sleep(0.5)
    os.close(fd)
    return None


def acquire_slot():
    """Block until we hold one of LOCAL_SLOTS slot locks; return (slot, fd), or (None, None)
    if a signal came first. A busy slot is a lock we couldn't take, never an exit code."""
    os.makedirs(LOCK_DIR, exist_ok=True)
    fds = [os.open(os.path.join(LOCK_DIR, f"slot-{n}.lock"), os.O_WRONLY | os.O_CREAT, 0o644)
           for n in range(1, LOCAL_SLOTS + 1)]
    held = (None, None)
    while stop_signal is None and held[0] is None:
        for n, fd in enumerate(fds, 1):
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                held = (n, fd)
                break
            except BlockingIOError:
                pass
        else:
            time.sleep(0.5)
    for fd in fds:
        if fd != held[1]:
            os.close(fd)
    return held


def run_local(command, root, outs):
    started = time.monotonic()
    slot, slot_fd = acquire_slot()
    if slot is None:
        return 128 + stop_signal
    queued = time.monotonic() - started
    say(f"running on {socket.gethostname()}, slot {slot}/{LOCAL_SLOTS}, after {queued:.1f}s in queue")
    job = subprocess.Popen(["bash", "-c", "--", command], stdin=subprocess.DEVNULL, start_new_session=True)
    stopper = threading.Thread(target=stop_local, args=(job,), daemon=True)
    stopper.start()
    rc = job.wait()
    rc = 128 - rc if rc < 0 else rc
    drain_group(job.pid)
    job_time = time.monotonic() - started - queued
    cleanup(root)
    os.close(slot_fd)
    if outs:
        say("--out: the job ran in place here, nothing to copy back")
    if stop_signal is not None:
        rc = 128 + stop_signal
    say(f"done on {socket.gethostname()}: queue {queued:.1f}s, job {job_time:.1f}s, "
        f"total {time.monotonic() - started:.1f}s, exit {rc}")
    return rc


def stop_local(job):
    """On a signal, TERM the job's group, and KILL it after GRACE if the leader ignores
    TERM: the main thread's wait can't end while the leader lives."""
    while job.poll() is None and stop_signal is None:
        time.sleep(0.2)
    if job.poll() is not None:
        return
    kill_group(job.pid, signal.SIGTERM)
    deadline = time.monotonic() + GRACE
    while job.poll() is None and time.monotonic() < deadline:
        time.sleep(0.2)
    if job.poll() is None:
        kill_group(job.pid, signal.SIGKILL)


def drain_group(pgid):
    """TERM what the job left in its group, and KILL the group if anything outlives GRACE."""
    kill_group(pgid, signal.SIGTERM)
    deadline = time.monotonic() + GRACE
    while time.monotonic() < deadline:
        try:
            os.killpg(pgid, 0)
        except ProcessLookupError:
            return
        time.sleep(0.1)
    kill_group(pgid, signal.SIGKILL)


def kill_group(pgid, sig):
    try:
        os.killpg(pgid, sig)
    except (ProcessLookupError, PermissionError):
        pass


def cleanup(root):
    if root and os.path.isfile(os.path.join(root, ".heavy-cleanup")):
        rc = subprocess.call(["bash", ".heavy-cleanup"], cwd=root, stdin=subprocess.DEVNULL)
        if rc:
            say(f".heavy-cleanup exited {rc}")


def home_relative(path):
    """The copy lives at the same path relative to home on msi-dux, or None if path isn't under home."""
    home = os.path.realpath(os.path.expanduser("~"))
    real = os.path.realpath(path)
    if os.path.commonpath([home, real]) != home or real == home:
        say(f"{path} isn't under {home}; the copy needs the same path on {REMOTE_NAME}")
        return None
    return os.path.relpath(real, home)


def rsync(*args):
    return subprocess.call(["rsync", "-a", "-e", RSH, *args])


def failed(message):
    """Report heavy's own failure, unless a signal caused it (a Ctrl-C kills rsync too)."""
    if stop_signal is not None:
        return 128 + stop_signal
    say(message)
    return FAILED


def run_remote(command, root, outs):
    started = time.monotonic()
    if root is None:
        say("a remote run copies the git worktree, and this isn't one")
        return FAILED
    common = git("-C", root, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if common is None:
        say(f"git can't find the common dir of {root}")
        return FAILED
    common = os.path.realpath(common)
    # A linked worktree's .git is a pointer to the common dir: mirror that to its own
    # path too. A plain repo's .git is inside the tree and goes with it.
    mirror = None if common.startswith(os.path.realpath(root) + os.sep) else common
    rel_root = home_relative(root)
    if rel_root is None:
        return FAILED
    rel_cwd = home_relative(os.getcwd())  # inside root, so under home too
    rel_common = home_relative(mirror) if mirror else ""
    if rel_common is None:
        return FAILED
    # Two runs of one worktree would overwrite each other's copy.
    tree_fd = acquire(lock_path("tree", root))
    if tree_fd is None:
        return 128 + stop_signal
    # The common dir is written by a worktree's mirror and by a main checkout's own tree
    # copy (its .git is inside it), so both shapes sync under one lock per repo.
    git_fd = acquire(lock_path("git", common))
    if git_fd is None:
        return 128 + stop_signal
    queued = time.monotonic() - started
    sync_started = time.monotonic()
    dirs = [rel_root] + ([rel_common] if rel_common else [])
    prepare = subprocess.run([*SSH_ARGS, REMOTE, "bash", "-s", "--", *map(shlex.quote, dirs)],
                             input=PREPARE_SCRIPT.encode())
    if prepare.returncode:
        return failed(f"preparing the copy on {REMOTE_NAME} failed (ssh exited {prepare.returncode})")
    if mirror:
        rc = rsync("--delete", f"{mirror}/", f"{REMOTE}:{rel_common}/")
        if rc:
            return failed(f"mirroring {mirror} failed (rsync {rc})")
    ignore = os.path.join(root, ".heavyignore")
    rc = rsync("--delete", *([f"--exclude-from={ignore}"] if os.path.isfile(ignore) else []),
               f"{root}/", f"{REMOTE}:{rel_root}/")
    if rc:
        return failed(f"copying {root} failed (rsync {rc})")
    os.close(git_fd)
    if stop_signal is not None:
        return 128 + stop_signal
    sync_time = time.monotonic() - sync_started
    script = REMOTE_SCRIPT
    values = {"mark": MARK[1:-1].decode(), "grace": str(GRACE), "grace_tenths": str(GRACE * 10),
              "lock_dir": shlex.quote(LOCK_DIR),
              "slots": str(REMOTE_SLOTS), "cwd": shlex.quote(rel_cwd), "root": shlex.quote(rel_root),
              "command": shlex.quote(command)}
    for key, value in values.items():
        script = script.replace("{" + key + "}", value)
    job_started = time.monotonic()
    # Its own session keeps a Ctrl-C or a group kill (agent-wait) off ssh: heavy then closes
    # ssh's stdin and still hears the remote exit. If heavy dies, the pipe closes all the same.
    ssh = subprocess.Popen([*SSH_ARGS, REMOTE, "bash", "-l", "-s"],
                           stdin=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    try:
        ssh.stdin.write(script.encode())
        ssh.stdin.flush()
    except (BrokenPipeError, ValueError):  # ssh died, or a signal closed its stdin already
        pass
    events = {}
    pump = threading.Thread(target=pump_stderr, args=(ssh.stderr, events, job_started), daemon=True)
    pump.start()
    stopper = threading.Thread(target=stop_remote, args=(ssh,), daemon=True)
    stopper.start()
    ssh.wait()
    pump.join()
    slot_at = events.get("slot", (None, job_started))[1]
    done_at = events.get("job-done", (None, time.monotonic()))[1]
    copy_started = time.monotonic()
    for out in outs if "exit" in events else []:  # a lost connection has nothing to copy from
        copy_back(out, rel_root, root)
    copy_time = time.monotonic() - copy_started
    os.close(tree_fd)
    if "exit" not in events:
        say(f"lost the job on {REMOTE_NAME} (ssh exited {ssh.returncode})")
        return 128 + stop_signal if stop_signal is not None else FAILED
    rc = int(events["exit"][0])
    if stop_signal is not None:
        rc = 128 + stop_signal
    say(f"done on {REMOTE_NAME}: queue {queued + slot_at - job_started:.1f}s, sync {sync_time:.1f}s, "
        f"job {done_at - slot_at:.1f}s, copy-back {copy_time:.1f}s, "
        f"total {time.monotonic() - started:.1f}s, exit {rc}")
    return rc


def pump_stderr(stream, events, job_started):
    """Pass the remote stderr through, minus the protocol lines, which go to events.

    A protocol line can follow job output that has no final newline, so look for it
    anywhere in a line, and hold back a partial line only from its first ASCII RS byte on.
    """
    fd = stream.fileno()
    buffer = b""
    while chunk := os.read(fd, 65536):
        buffer += chunk
        *lines, buffer = buffer.split(b"\n")
        for line in lines:
            text, mark, protocol = line.partition(MARK)
            if text or not mark:
                sys.stderr.buffer.write(text + b"\n")
            if mark:
                handle(protocol.decode(errors="replace"), events, job_started)
        held = buffer.find(MARK[:1])
        sys.stderr.buffer.write(buffer if held < 0 else buffer[:held])
        buffer = b"" if held < 0 else buffer[held:]
        sys.stderr.buffer.flush()
    sys.stderr.buffer.write(buffer)


def handle(protocol, events, job_started):
    name, _, value = protocol.partition(" ")
    events[name] = (value, time.monotonic())
    if name == "slot":
        say(f"running on {REMOTE_NAME}, slot {value}/{REMOTE_SLOTS}, "
            f"after {time.monotonic() - job_started:.1f}s waiting for it")
    elif name == "cleanup-failed":
        say(f".heavy-cleanup on {REMOTE_NAME} exited {value}")


def stop_remote(ssh):
    """On a signal, close the script's stdin: the remote side then kills the job's group
    and runs .heavy-cleanup. Kill ssh only if that takes far longer than GRACE."""
    while ssh.poll() is None and stop_signal is None:
        time.sleep(0.2)
    if ssh.poll() is not None:
        return
    ssh.stdin.close()
    deadline = time.monotonic() + GRACE + 60
    while ssh.poll() is None and time.monotonic() < deadline:
        time.sleep(0.2)
    if ssh.poll() is None:
        ssh.kill()


def copy_back(out, rel_root, root):
    """Copy back what the job made or updated: --update skips files that are newer here,
    and unchanged files match on size and mtime, so rsync skips them too."""
    path = os.path.relpath(os.path.join(os.getcwd(), out), root)
    if path == ".." or path.startswith(".." + os.sep):
        say(f"--out {out}: outside the worktree, skipped")
        return
    result = subprocess.run(["rsync", "-aR", "--update", "--out-format=%n", "-e", RSH,
                             f"{REMOTE}:{rel_root}/./{path}", f"{root}/"], capture_output=True, text=True)
    if result.returncode == 23 and "No such file" in result.stderr:
        say(f"--out {out}: not on {REMOTE_NAME} after the job")
    elif result.returncode:
        say(f"--out {out}: rsync {result.returncode}: {result.stderr.strip()[-300:]}")
    else:
        files = [line for line in result.stdout.splitlines() if not line.endswith("/")]
        say(f"--out {out}: copied back {len(files)} file(s)")


def reachable():
    try:
        return subprocess.run([*SSH_ARGS, REMOTE, "true"], stdin=subprocess.DEVNULL, capture_output=True,
                              timeout=CONNECT_TIMEOUT + 1).returncode == 0
    except subprocess.TimeoutExpired:
        return False


def on_signal(signum, _frame):
    global stop_signal
    if stop_signal is None:
        stop_signal = signum


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, usage="heavy [--out PATH]... [--local-ok] [--] COMMAND...",
        epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--out", action="append", default=[], metavar="PATH",
                        help="after a remote run, copy PATH (relative to here) back if the job made "
                             "or updated it; repeatable")
    parser.add_argument("--local-ok", action="store_true",
                        help="allow a local run where AGENT_HEAVY_JOBS=deny")
    parser.add_argument("command", nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
    args = parser.parse_args()
    words = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not words:
        parser.error("a command is required")
    command = words[0] if len(words) == 1 else shlex.join(words)
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, on_signal)
    root = git("rev-parse", "--show-toplevel")
    where = os.environ.get("HEAVY_WHERE", "")
    if where not in ("", "local", "remote"):
        parser.error("HEAVY_WHERE must be local or remote")
    silent = False  # msi-dux didn't answer
    if not where:
        if socket.gethostname() == REMOTE_NAME:
            where = "local"
        elif reachable():
            where = "remote"
        else:
            where, silent = "local", True
    if where == "remote":
        return run_remote(command, root, args.out)
    why = f"{REMOTE_NAME} didn't answer within {CONNECT_TIMEOUT}s" if silent else None
    if os.environ.get("AGENT_HEAVY_JOBS") == "deny" and not args.local_ok:
        say(f"{why + ', and ' if why else ''}AGENT_HEAVY_JOBS=deny on {socket.gethostname()}: "
            f"not running here. Pass --local-ok if a local run is approved")
        return FAILED
    if why:
        say(f"{why}; running here")
    return run_local(command, root, args.out)


if __name__ == "__main__":
    sys.exit(main())
