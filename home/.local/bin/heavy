#!/usr/bin/env python3
"""Run a heavy job (a build, a test replay) locally or on an eligible Tailscale peer.

COMMAND runs from the current directory through `bash -c`: one word is a shell
command line (`heavy -- 'cd lab && make'`), several are an argv (`heavy -- touch
"my file"`). On a peer it runs in a dedicated staging directory under
~/.cache/heavy/work/<id>/tree (uncommitted edits included); linked worktrees get
their own copy of the common .git dir under ~/.cache/heavy/work/<id>/git so
concurrent jobs never share refs or touch any real checkout on the peer.
Concurrency is capped at one slot per 10 GiB of host RAM (min 1). heavy prints
`heavy:` lines to stderr and exits with the job's status.
"""

import argparse
import fcntl
import getpass
import hashlib
import json
import os
import re
import secrets
import shlex
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time

SSH = os.environ.get("HEAVY_SSH", "ssh")
CONNECT_TIMEOUT = 5  # seconds; per-peer ssh timeout for probing and transport
SSH_ARGS = [SSH, "-o", "BatchMode=yes", "-o", f"ConnectTimeout={CONNECT_TIMEOUT}"]
LOCK_DIR = os.environ.get("HEAVY_LOCK_DIR") or f"/tmp/heavy-{os.getuid()}"
STAGE_ROOT = ".cache/heavy/work"
GRACE = 10  # seconds between SIGTERM and SIGKILL for the job's process group
FAILED = 255  # heavy's own failures; the job didn't run or its status was lost
DENIED = object()  # peer began denying before the remote job started
MARK = f"\x1eheavy-{secrets.token_hex(8)} ".encode()  # per-run protocol prefix on stderr

EPILOG = """\
routing:
  If AGENT_HEAVY_JOBS is not `deny` here, heavy runs locally, always.
  If AGENT_HEAVY_JOBS=deny, heavy reads your own online Linux peers from
  `tailscale status --json`, sorts by full MagicDNS name (or Tailscale IP),
  probes each over ssh as the current user, and picks the first eligible peer
  (deny is re-checked before starting the job). If none answers, heavy runs
  here with AGENT_HEAVY_JOBS unset for that job.

staging and repo files:
  Staged copies live under ~/.cache/heavy/work on the peer. Remove old ones:
    rm -rf ~/.cache/heavy/work
  .heavyignore    (worktree root) rsync exclude patterns; don't exclude .git
  .heavy-cleanup  (worktree root) bash script run after the job, even on signal

exit codes:
  job status unchanged; 128+N on signal N; 255 on heavy failure; 2 bad args

Send heavy (or its agent-wait group) TERM, INT or HUP to stop the job's process
group (here or on the peer) and run .heavy-cleanup. A KILL leaves a local job
running; a remote one still stops when its ssh pipe closes.
"""

# Checks login env, systemd user env, and environment.d so a deny in
# ~/.config/environment.d/*.conf is seen even over non-session ssh.
DENY_CHECK = r"""
is_denied() {
  [ "${AGENT_HEAVY_JOBS:-}" = deny ] && return 0
  XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" \
    systemctl --user show-environment 2>/dev/null | grep -qx 'AGENT_HEAVY_JOBS=deny' && return 0
  for p in /usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator \
           /lib/systemd/user-environment-generators/30-systemd-environment-d-generator; do
    if [ -x "$p" ]; then "$p" 2>/dev/null | grep -qx 'AGENT_HEAVY_JOBS=deny'; return $?; fi
  done
  grep -qxs 'AGENT_HEAVY_JOBS=deny' "${XDG_CONFIG_HOME:-$HOME/.config}"/environment.d/*.conf
}
"""

PROBE_SCRIPT = DENY_CHECK + "\nis_denied && exit 10\nexit 0\n"

# Creates the staging dir and refuses symlinked parents or any path resolving
# outside ~/.cache/heavy/work before rsync --delete ever runs.
PREPARE_SCRIPT = r"""
set -e
id={stage_id}; need_git={need_git}; root="$HOME/.cache/heavy/work"
case "$id" in ''|*[!0-9a-f]*) echo "heavy: invalid staging id: $id" >&2; exit 1 ;; esac
for p in "$HOME/.cache" "$HOME/.cache/heavy" "$root" "$root/$id" "$root/$id/tree" ${need_git:+"$root/$id/git"}; do
  [ -L "$p" ] && { echo "heavy: refusing symlink in staging path: $p" >&2; exit 1; }
done
mkdir -p -- "$root/$id/tree"
if [ -n "$need_git" ]; then mkdir -p -- "$root/$id/git"; fi
real_root=$(cd -P -- "$root" && pwd -P)
for sub in tree ${need_git:+git}; do
  real_sub=$(cd -P -- "$root/$id/$sub" && pwd -P)
  case "$real_sub" in "$real_root"/*) ;; *)
    echo "heavy: staging path $real_sub is outside $real_root" >&2; exit 1 ;;
  esac
done
"""

# Fed to `bash -l -s` on the peer: login shells may not be POSIX (e.g. fish),
# and -l loads the login PATH. Stdin stays open while local heavy lives, so EOF
# means heavy stopped or died. Braces make bash parse the whole script first so
# the watcher's cat doesn't swallow unread script lines.
REMOTE_SCRIPT = r"""{
set -m  # job control: the job gets its own process group, so one kill reaches all of it
mark() { printf '\036{mark} %s\n' "$*" >&2; }
{deny_check}
if is_denied; then mark denied; exit 10; fi
stop() {
  stopped=1
  if [ -n "${pid:-}" ]; then
    kill -TERM -- "-$pid" 2>/dev/null
    # KILLs a leader that ignores TERM: the wait loop below can't end while it lives.
    (sleep {grace}; kill -KILL -- "-$pid" 2>/dev/null) 9>&- >/dev/null 2>&1 &
    timer=$!
  fi
}
trap stop TERM INT HUP
(cat >/dev/null; kill -TERM $$) >/dev/null 2>&1 &
watcher=$!
fail() { mark "$@"; kill -- "-$watcher" 2>/dev/null; exit 255; }
tree_path="$HOME"/{stage_tree}
if [ -n {stage_gitdir} ]; then
  gitdir_path="$HOME"/{stage_gitdir}
  printf 'gitdir: %s\n' "$gitdir_path" > "$tree_path/.git"
  [ -f "$gitdir_path/gitdir" ] && printf '%s/.git\n' "$tree_path" > "$gitdir_path/gitdir"
fi
# One slot per 10 GiB of host RAM (min 1): an 8 GiB VM or heavy build needs ~10 GiB with headroom.
slots=$(awk '/^MemTotal:/ {s = int($2 / 10485760); print (s < 1 ? 1 : s)}' /proc/meminfo 2>/dev/null)
slots=${slots:-1}
lock_dir={lock_dir}; lock_dir=${lock_dir:-/tmp/heavy-$(id -u)}
mkdir -m 700 -p -- "$lock_dir" || fail lock-failed "$lock_dir"
while [ -z "${stopped:-}" ]; do
  for slot in $(seq 1 "$slots"); do
    # fd 9 holds the slot. Jobs get 9>&- so a daemon they start can't inherit it.
    exec 9>"$lock_dir/slot-$slot.lock" || fail lock-failed "$lock_dir/slot-$slot.lock"
    flock -n 9 && break 2
  done
  exec 9>&-
  sleep 1
done
if [ -n "${stopped:-}" ]; then rc=143; else
  mark slot "$slot/$slots"
  (cd "$HOME"/{stage_cwd} && exec bash -c -- {command}) 9>&- </dev/null &
  pid=$!
  [ -n "${stopped:-}" ] && stop  # a stop that came between the check and the start
  while :; do
    wait "$pid"; rc=$?
    kill -0 "$pid" 2>/dev/null || break  # wait returned early for the trap
  done
  # TERM what the job left in its group, and KILL if anything outlives GRACE.
  kill -TERM -- "-$pid" 2>/dev/null
  for _ in $(seq {grace_tenths}); do kill -0 -- "-$pid" 2>/dev/null || break; sleep 0.1; done
  kill -KILL -- "-$pid" 2>/dev/null
  [ -n "${timer:-}" ] && kill -- "-$timer" 2>/dev/null
  mark job-done
  if [ -f "$tree_path/.heavy-cleanup" ]; then
    (cd "$tree_path" && bash .heavy-cleanup) 9>&- </dev/null || mark cleanup-failed $?
  fi
fi
kill -- "-$watcher" 2>/dev/null
mark exit "$rc"
exit "$rc"
}
"""

stop_signal = None


def say(message):
    print(f"heavy: {message}", file=sys.stderr, flush=True)


def render(template, values):
    return re.sub(r"\{([a-z_]+)\}", lambda m: values.get(m.group(1), m.group(0)), template)


def host_slots():
    """One slot per 10 GiB of host RAM (min 1): an 8 GiB VM or heavy build needs ~10 GiB with headroom."""
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    return max(1, int(line.split()[1]) // (10 * 1024 * 1024))
    except OSError:
        pass
    return 1


def git(*args):
    res = subprocess.run(["git", *args], capture_output=True, text=True)
    return res.stdout.strip() if res.returncode == 0 else None


def stage_id(root):
    """Stable 12-hex id for one (source host, worktree) pair."""
    try:
        with open("/etc/machine-id") as f:
            host_id = f.read().strip()
    except OSError:
        host_id = ""
    return hashlib.sha256(f"{host_id or socket.gethostname()}\0{os.path.realpath(root)}".encode()).hexdigest()[:12]


def acquire_any(paths):
    """Block until one lock in `paths` is held; return (1-based index, fd), or (None, None) on signal.

    Python opens fds non-inheritable so children never keep holding locks.
    Open or non-busy flock errors raise OSError immediately instead of looping.
    """
    os.makedirs(LOCK_DIR, mode=0o700, exist_ok=True)
    fds = []
    try:
        fds = [os.open(p, os.O_WRONLY | os.O_CREAT, 0o600) for p in paths]
        held = (None, None)
        while stop_signal is None and held[0] is None:
            for idx, fd in enumerate(fds, 1):
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    held = (idx, fd)
                    break
                except BlockingIOError:
                    pass
            else:
                time.sleep(0.5)
        for fd in fds:
            if fd != held[1]:
                os.close(fd)
        return held
    except OSError:
        for fd in fds:
            os.close(fd)
        raise


def kill_group(pgid, sig):
    try:
        os.killpg(pgid, sig)
    except (ProcessLookupError, PermissionError):
        pass


def stop_local(job):
    """On a signal, TERM the job's group, and KILL after GRACE if the leader ignores TERM."""
    while job.poll() is None and stop_signal is None:
        time.sleep(0.2)
    if job.poll() is not None:
        return
    kill_group(job.pid, signal.SIGTERM)
    deadline = time.monotonic() + GRACE
    while job.poll() is None and time.monotonic() < deadline:
        time.sleep(0.2)
    if job.poll() is None:
        kill_group(job.pid, signal.SIGKILL)


def drain_group(pgid):
    kill_group(pgid, signal.SIGTERM)
    deadline = time.monotonic() + GRACE
    while time.monotonic() < deadline:
        try:
            os.killpg(pgid, 0)
        except ProcessLookupError:
            return
        time.sleep(0.1)
    kill_group(pgid, signal.SIGKILL)


def run_local(command, root, outs, lift_deny=False):
    started = time.monotonic()
    slots = host_slots()
    try:
        slot, slot_fd = acquire_any([os.path.join(LOCK_DIR, f"slot-{n}.lock") for n in range(1, slots + 1)])
    except OSError as err:
        say(f"can't open slot lock in {LOCK_DIR}: {err}")
        return FAILED
    if slot is None:
        return 128 + stop_signal
    queued = time.monotonic() - started
    say(f"running on {socket.gethostname()}, slot {slot}/{slots}, after {queued:.1f}s in queue")
    job_env = {k: v for k, v in os.environ.items() if k != "AGENT_HEAVY_JOBS"} if lift_deny else None
    job = subprocess.Popen(["bash", "-c", "--", command], stdin=subprocess.DEVNULL,
                           env=job_env, start_new_session=True)
    threading.Thread(target=stop_local, args=(job,), daemon=True).start()
    rc = job.wait()
    rc = 128 - rc if rc < 0 else rc
    drain_group(job.pid)
    job_time = time.monotonic() - started - queued
    if root and os.path.isfile(os.path.join(root, ".heavy-cleanup")):
        if (crc := subprocess.call(["bash", ".heavy-cleanup"], cwd=root, stdin=subprocess.DEVNULL)):
            say(f".heavy-cleanup exited {crc}")
    os.close(slot_fd)
    if outs:
        say("--out: the job ran in place here, nothing to copy back")
    if stop_signal is not None:
        rc = 128 + stop_signal
    say(f"done on {socket.gethostname()}: queue {queued:.1f}s, job {job_time:.1f}s, "
        f"total {time.monotonic() - started:.1f}s, exit {rc}")
    return rc


def failed(message):
    if stop_signal is not None:
        return 128 + stop_signal
    say(message)
    return FAILED


def run_remote(command, root, outs, peer, target, ssh_args):
    started = time.monotonic()
    if root is None:
        say("a remote run copies the git worktree, and this isn't one")
        return FAILED
    real_root = os.path.realpath(root)
    sub_cwd = os.path.relpath(os.path.realpath(os.getcwd()), real_root)
    if sub_cwd == ".." or sub_cwd.startswith(".." + os.sep):
        say(f"{os.getcwd()} resolves outside worktree {root}")
        return FAILED
    common = git("-C", root, "rev-parse", "--path-format=absolute", "--git-common-dir")
    gitdir = git("-C", root, "rev-parse", "--path-format=absolute", "--git-dir")
    if common is None or gitdir is None:
        say(f"git can't find the git dirs of {root}")
        return FAILED
    common, gitdir = os.path.realpath(common), os.path.realpath(gitdir)
    mirror = None if common.startswith(real_root + os.sep) else common
    sid = stage_id(real_root)
    stage_tree = f"{STAGE_ROOT}/{sid}/tree"
    stage_cwd = stage_tree if sub_cwd == "." else f"{stage_tree}/{sub_cwd}"
    stage_git = f"{STAGE_ROOT}/{sid}/git" if mirror else ""
    stage_gitdir = ""
    if mirror:
        if os.path.commonpath([common, gitdir]) != common:
            say(f"git dir {gitdir} isn't inside common dir {common}")
            return FAILED
        rel_gitdir = os.path.relpath(gitdir, common)
        stage_gitdir = stage_git if rel_gitdir == "." else f"{stage_git}/{rel_gitdir}"
    try:
        _, tree_fd = acquire_any([os.path.join(LOCK_DIR, f"tree-{sid}.lock")])
    except OSError as err:
        say(f"can't open worktree lock in {LOCK_DIR}: {err}")
        return FAILED
    if tree_fd is None:
        return 128 + stop_signal
    rsh = shlex.join(ssh_args)
    try:
        queued = time.monotonic() - started
        sync_started = time.monotonic()
        prep = render(PREPARE_SCRIPT, {"stage_id": shlex.quote(sid), "need_git": "1" if mirror else "''"})
        if (rc := subprocess.run([*ssh_args, target, "bash", "-s"], input=prep.encode()).returncode):
            return failed(f"preparing staging dir on {peer} failed (ssh exited {rc})")
        if mirror:
            if (rc := subprocess.call(["rsync", "-a", "-e", rsh, "--delete", f"{mirror}/", f"{target}:{stage_git}/"])):
                return failed(f"mirroring {mirror} failed (rsync {rc})")
        ignore = os.path.join(root, ".heavyignore")
        rc = subprocess.call(["rsync", "-a", "-e", rsh, "--delete",
                              *([f"--exclude-from={ignore}"] if os.path.isfile(ignore) else []),
                              f"{root}/", f"{target}:{stage_tree}/"])
        if rc:
            return failed(f"copying {root} failed (rsync {rc})")
        if stop_signal is not None:
            return 128 + stop_signal
        sync_time = time.monotonic() - sync_started
        script = render(REMOTE_SCRIPT, {
            "mark": MARK[1:-1].decode(), "deny_check": DENY_CHECK,
            "grace": str(GRACE), "grace_tenths": str(GRACE * 10),
            "lock_dir": shlex.quote(os.environ.get("HEAVY_LOCK_DIR", "")),
            "stage_cwd": shlex.quote(stage_cwd), "stage_tree": shlex.quote(stage_tree),
            "stage_gitdir": shlex.quote(stage_gitdir), "command": shlex.quote(command),
        })
        job_started = time.monotonic()
        # Own session keeps Ctrl-C or group kill (agent-wait) off ssh: heavy closes stdin and still hears exit.
        ssh = subprocess.Popen([*ssh_args, target, "bash", "-l", "-s"],
                               stdin=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
        try:
            ssh.stdin.write(script.encode())
            ssh.stdin.flush()
        except (BrokenPipeError, ValueError):
            pass
        events = {}
        pump = threading.Thread(target=pump_stderr, args=(ssh.stderr, events, job_started, peer), daemon=True)
        pump.start()
        threading.Thread(target=stop_remote, args=(ssh,), daemon=True).start()
        ssh.wait()
        pump.join()
        if "denied" in events:
            return DENIED
        if "lock-failed" in events:
            say(f"can't open slot lock on {peer}: {events['lock-failed'][0]}")
            return FAILED
        slot_at = events.get("slot", (None, job_started))[1]
        done_at = events.get("job-done", (None, time.monotonic()))[1]
        copy_started = time.monotonic()
        for out in outs if "exit" in events else []:  # a lost connection has nothing to copy from
            copy_back(out, stage_tree, real_root, peer, target, rsh)
        copy_time = time.monotonic() - copy_started
        if "exit" not in events:
            say(f"lost the job on {peer} (ssh exited {ssh.returncode})")
            return 128 + stop_signal if stop_signal is not None else FAILED
        rc = 128 + stop_signal if stop_signal is not None else int(events["exit"][0])
        say(f"done on {peer}: queue {queued + slot_at - job_started:.1f}s, sync {sync_time:.1f}s, "
            f"job {done_at - slot_at:.1f}s, copy-back {copy_time:.1f}s, "
            f"total {time.monotonic() - started:.1f}s, exit {rc}")
        return rc
    finally:
        os.close(tree_fd)


def pump_stderr(stream, events, job_started, peer):
    """Pass remote stderr through, minus protocol lines, which go to events."""
    fd, buf = stream.fileno(), b""
    while chunk := os.read(fd, 65536):
        buf += chunk
        *lines, buf = buf.split(b"\n")
        for line in lines:
            text, mark, proto = line.partition(MARK)
            if text or not mark:
                sys.stderr.buffer.write(text + b"\n")
            if mark:
                name, _, val = proto.decode(errors="replace").partition(" ")
                events[name] = (val, time.monotonic())
                if name == "slot":
                    say(f"running on {peer}, slot {val}, after {time.monotonic() - job_started:.1f}s waiting for it")
                elif name == "cleanup-failed":
                    say(f".heavy-cleanup on {peer} exited {val}")
        held = buf.find(MARK[:1])
        sys.stderr.buffer.write(buf if held < 0 else buf[:held])
        buf = b"" if held < 0 else buf[held:]
        sys.stderr.buffer.flush()
    sys.stderr.buffer.write(buf)


def stop_remote(ssh):
    """On a signal, close ssh stdin so the peer kills the job group and runs .heavy-cleanup."""
    while ssh.poll() is None and stop_signal is None:
        time.sleep(0.2)
    if ssh.poll() is not None:
        return
    ssh.stdin.close()
    deadline = time.monotonic() + GRACE + 60
    while ssh.poll() is None and time.monotonic() < deadline:
        time.sleep(0.2)
    if ssh.poll() is None:
        ssh.kill()


def copy_back(out, stage_tree, real_root, peer, target, rsh):
    """Copy back what the job made or updated; never overwrite .git."""
    path = os.path.relpath(os.path.realpath(os.path.join(os.getcwd(), out)), real_root)
    if path == ".." or path.startswith(".." + os.sep):
        say(f"--out {out}: outside the worktree, skipped")
        return
    if path == ".git" or path.startswith(".git" + os.sep):
        say(f"--out {out}: refusing to overwrite .git, skipped")
        return
    res = subprocess.run(["rsync", "-aR", "--update", "--exclude=.git", "--out-format=%n", "-e", rsh,
                          f"{target}:{stage_tree}/./{path}", f"{real_root}/"], capture_output=True, text=True)
    if res.returncode == 23 and "No such file" in res.stderr:
        say(f"--out {out}: not on {peer} after the job")
    elif res.returncode:
        say(f"--out {out}: rsync {res.returncode}: {res.stderr.strip()[-300:]}")
    else:
        files = [line for line in res.stdout.splitlines() if not line.endswith("/")]
        say(f"--out {out}: copied back {len(files)} file(s)")


def tailscale_peers():
    """Own online Linux peers from `tailscale status --json`: (label, host, ssh_host_keys), sorted by host."""
    try:
        res = subprocess.run(["tailscale", "status", "--json"], stdin=subprocess.DEVNULL,
                             capture_output=True, text=True, timeout=CONNECT_TIMEOUT)
        data = json.loads(res.stdout) if res.returncode == 0 else {}
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return []
    if data.get("BackendState") not in (None, "Running"):
        return []
    self_uid = (data.get("Self") or {}).get("UserID")
    suffix = (data.get("MagicDNSSuffix") or "").strip(".")
    peers = {}
    for p in (data.get("Peer") or {}).values():
        if not isinstance(p, dict) or not p.get("Online") or p.get("ShareeNode"):
            continue
        if (p.get("OS") or "").lower() != "linux":
            continue
        if self_uid is not None and p.get("UserID") is not None and p["UserID"] != self_uid:
            continue
        dns = (p.get("DNSName") or "").rstrip(".")
        if suffix and dns and not dns.endswith("." + suffix):
            continue
        ips = p.get("TailscaleIPs") or []
        host = dns or next((a for a in ips if ":" not in a), ips[0] if ips else "")
        if not host or host.startswith("-") or any(c.isspace() for c in host):
            continue
        keys = [k for k in (p.get("sshHostKeys") or []) if isinstance(k, str) and "\n" not in k]
        peers[host] = (p.get("HostName") or host, host, keys)
    return [peers[h] for h in sorted(peers)]


def ssh_args_for(host, host_keys):
    """Build ssh argv; pass Tailscale-attested sshHostKeys via GlobalKnownHostsFile when present."""
    if not host_keys:
        return list(SSH_ARGS), None
    tmp_dir = "/tmp" if any(c.isspace() for c in tempfile.gettempdir()) else None
    fd, path = tempfile.mkstemp(prefix="heavy-kh-", dir=tmp_dir)
    with os.fdopen(fd, "w") as f:
        for key in host_keys:
            f.write(f"{host} {key}\n")
    return [*SSH_ARGS, "-o", f"GlobalKnownHostsFile={path}"], path


def probe_peer(target, ssh_args):
    try:
        return subprocess.run([*ssh_args, target, "bash", "-l", "-s"], input=PROBE_SCRIPT.encode(),
                              capture_output=True, timeout=CONNECT_TIMEOUT + 2).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def on_signal(signum, _frame):
    global stop_signal
    if stop_signal is None:
        stop_signal = signum


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, usage="heavy [--out PATH]... [--] COMMAND...",
        epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--out", action="append", default=[], metavar="PATH",
                        help="after a remote run, copy PATH (relative to here) back if created/updated; repeatable")
    parser.add_argument("command", nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
    args = parser.parse_args()
    words = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not words:
        parser.error("a command is required")
    command = words[0] if len(words) == 1 else shlex.join(words)
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, on_signal)
    root = git("rev-parse", "--show-toplevel")
    if os.environ.get("AGENT_HEAVY_JOBS") == "deny":
        user = getpass.getuser()
        for label, host, host_keys in tailscale_peers():
            if stop_signal is not None:
                return 128 + stop_signal
            ssh_args, kh_path = ssh_args_for(host, host_keys)
            try:
                target = f"{user}@{host}"
                if not probe_peer(target, ssh_args):
                    continue
                rc = run_remote(command, root, args.out, label, target, ssh_args)
                if rc is DENIED:
                    say(f"{label} now sets AGENT_HEAVY_JOBS=deny; skipping")
                    continue
                return rc
            finally:
                if kh_path:
                    try:
                        os.unlink(kh_path)
                    except OSError:
                        pass
        if stop_signal is not None:
            return 128 + stop_signal
        say("no eligible peer answered; running here with AGENT_HEAVY_JOBS lifted")
        return run_local(command, root, args.out, lift_deny=True)
    return run_local(command, root, args.out)


if __name__ == "__main__":
    sys.exit(main())
