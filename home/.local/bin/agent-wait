#!/usr/bin/env python3
"""Start a long job detached, wait for it in bounded steps, or stop it.

The log file is the only handle. `start` runs the job under a small supervisor
in a new session and, when a systemd user manager answers, in its own named
transient scope so it survives the caller's shell and session restarts. It
prints the resolved absolute log path and stores the job's identity and exit
status in LOG.job. `wait` blocks up to --max-seconds and reports a stall when
LOG stops changing for --stall-minutes. `stop` terminates the whole job. Linux
only.
"""

import argparse
import fcntl
import json
import math
import os
import signal
import stat
import subprocess
import sys
import time

EXITED, BAD_INPUT, STALLED, FAILED, RUNNING = 0, 2, 3, 4, 124
STOP_TIMEOUT = 5.0

USAGE = """\
agent-wait start LOG -- COMMAND [ARG ...]
       agent-wait wait LOG [--stall-minutes M] [--max-seconds S]
       agent-wait stop LOG"""

EPILOG = """\
wait options:
  --stall-minutes M  report a stall after LOG is unchanged this long (default 15)
  --max-seconds S    return 124 after this long if the job still runs (default 540)

exit codes:
  start: 0 started | 2 bad input or job already running on LOG | 4 launch failed
  wait:  0 job exited 0 | 2 bad input or no job | 3 stalled | 4 failed, stopped, or unknown | 124 still running
  stop:  0 stopped or already ended | 2 bad input or no job | 4 could not stop
  (1 is reserved for crashes)

Limits: stall age carries across calls only through the log's mtime, so a
future mtime restarts the count, and a log deleted between calls gives 2.
"""


def err(message, code):
    print(f"agent-wait: {message}", file=sys.stderr)
    return code


def duration(text):
    value = float(text)
    if not math.isfinite(value) or value < 0:
        raise argparse.ArgumentTypeError(f"must be a finite number >= 0: {text!r}")
    return value


def job_path(log):
    return log + ".job"


def boot_id():
    with open("/proc/sys/kernel/random/boot_id") as f:
        return f.read().strip()


def open_regular(path, flags):
    """Open nonblocking, so a FIFO can't hang us; check the type on the descriptor."""
    fd = os.open(path, flags | os.O_NONBLOCK | os.O_CLOEXEC, 0o644)
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        raise OSError(f"not a regular file: {path}")
    os.set_blocking(fd, True)
    return fd


def write_json(path, data):
    """Write a sidecar file through a rename so readers never see a partial write."""
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(data, f)
            f.write("\n")
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def is_int(value):
    return isinstance(value, int) and not isinstance(value, bool)


def read_job(log):
    """Return a validated job record, None if missing, or 'corrupt' if malformed."""
    try:
        with open(job_path(log)) as f:
            data = json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        return "corrupt"
    if not isinstance(data, dict):
        return "corrupt"
    pid, st, bid, unit, code = (data.get(k) for k in ("pid", "start_time", "boot_id", "unit", "exit"))
    if (not is_int(pid) or pid <= 0 or not isinstance(st, str) or not st
            or not isinstance(bid, str) or not bid or not isinstance(unit, str)
            or (code is not None and not is_int(code))):
        return "corrupt"
    return {"pid": pid, "start_time": st, "boot_id": bid, "unit": unit, "exit": code}


def proc_stat(pid):
    """Return (state, pgrp, start_time) from /proc/PID/stat, or None if gone."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            text = f.read()
        # The command name may contain spaces and parentheses; fields after it
        # start at field 3 (state), field 5 is pgrp, field 22 is start time.
        fields = text[text.rindex(")") + 2:].split()
        return fields[0], int(fields[2]), fields[19]
    except (OSError, ValueError, IndexError):
        return None


def proc_start_time(pid):
    """Return the process's start time (to catch PID reuse), or None if gone or a zombie."""
    info = proc_stat(pid)
    return None if info is None or info[0] in ("Z", "X") else info[2]


def valid_unit(job):
    """Require the scope unit name to match this job's exact PID and start time."""
    return bool(job["unit"]) and job["unit"] == f"agent-wait-{job['pid']}-{job['start_time']}.scope"


def unit_active(unit):
    try:
        res = subprocess.run(
            ["systemctl", "--user", "show", "-p", "ActiveState", "--value", unit],
            stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=5)
        return res.returncode == 0 and res.stdout.strip() in (
            "active", "activating", "reloading", "deactivating")
    except (OSError, subprocess.TimeoutExpired):
        return False


def pid_matches(job):
    return job["boot_id"] == boot_id() and proc_start_time(job["pid"]) == job["start_time"]


def job_running(job):
    if not isinstance(job, dict) or job["boot_id"] != boot_id():
        return False
    return proc_start_time(job["pid"]) == job["start_time"] or (valid_unit(job) and unit_active(job["unit"]))


def pgrp_has_live(pgid):
    """True if any non-zombie process still belongs to process group pgid."""
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    for name in os.listdir("/proc"):
        if name.isdigit():
            info = proc_stat(name)
            if info is not None and info[0] not in ("Z", "X") and info[1] == pgid:
                return True
    return False


def wait_until(done, seconds, step=0.05):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if done():
            return True
        time.sleep(step)
    return done()


def last_line(path):
    try:
        with os.fdopen(open_regular(path, os.O_RDONLY), "rb") as f:
            f.seek(max(0, os.fstat(f.fileno()).st_size - 4096))
            lines = f.read().decode(errors="replace").split("\n")
    except OSError:
        return ""
    return next((line.strip()[-200:] for line in reversed(lines) if line.strip()), "")


def scopes_work():
    """True if `systemd-run --user --scope` works here (a user manager on the bus)."""
    try:
        return subprocess.run(
            ["systemd-run", "--user", "--scope", "--quiet", "--collect",
             f"--property=TimeoutStopSec={int(STOP_TIMEOUT)}s", "true"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def supervise(log, unit, command):
    """Record this supervisor's identity, run the job, and store its exit status."""
    record = {"pid": os.getpid(), "start_time": proc_start_time(os.getpid()),
              "boot_id": boot_id(), "unit": unit, "exit": None}
    try:
        write_json(job_path(log), record)
        rc = subprocess.call(command)
        record["exit"] = 128 - rc if rc < 0 else rc
        write_json(job_path(log), record)
    except OSError as error:
        # Unknown command or unwritable sidecar: exit stays None, which wait
        # reports as unknown (4), never as success.
        print(f"agent-wait: {error}", file=sys.stderr)


def start(log, command):
    log = os.path.abspath(log)
    if job_running(read_job(log)):
        return err(f"job already running on {log}; wait or stop it first", BAD_INPUT)
    try:
        log_fd = open_regular(log, os.O_WRONLY | os.O_APPEND | os.O_CREAT)
    except OSError as error:
        return err(error, BAD_INPUT)
    try:
        # Held on log_fd and inherited on fds 1-2 across fork and systemd-run
        # --scope so concurrent starts serialize and a running job blocks reuse.
        fcntl.flock(log_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(log_fd)
        return err(f"job already running on {log}; wait or stop it first", BAD_INPUT)
    if job_running(read_job(log)):
        os.close(log_fd)
        return err(f"job already running on {log}; wait or stop it first", BAD_INPUT)

    # Probed before forking: once the child execs systemd-run, a failure can't fall back.
    in_scope = scopes_work()
    try:
        # Write the stub before truncating LOG so an unwritable directory fails
        # without wiping an existing log, and parent can tell when supervise starts.
        write_json(job_path(log), {"starting": os.getpid()})
        os.ftruncate(log_fd, 0)
    except OSError as error:
        os.close(log_fd)
        return err(error, BAD_INPUT)

    sys.stdout.flush()
    pid = os.fork()
    if pid:
        # Wait until supervise writes LOG.job (which for scoped jobs happens
        # after systemd-run has moved the process into its own scope).
        def child_ready():
            job = read_job(log)
            if isinstance(job, dict) and job["pid"] == pid:
                return True
            try:
                done_pid, _ = os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                done_pid = pid
            return done_pid == pid

        wait_until(child_ready, 10, step=0.01)
        job = read_job(log)
        os.close(log_fd)
        if not (isinstance(job, dict) and job["pid"] == pid):
            try:
                os.unlink(job_path(log))
            except OSError:
                pass
            return err(f"supervisor failed to start; see {log}", FAILED)
        print(log)
        return EXITED

    # Supervisor. A new session survives the harness killing the calling shell's
    # process group; redirecting 0-2 away from harness pipes lets the tool call
    # return immediately. Dup log_fd onto 1-2 before 0 in case log_fd == 0.
    os.setsid()
    os.dup2(log_fd, 1)
    os.dup2(log_fd, 2)
    os.dup2(os.open(os.devnull, os.O_RDONLY), 0)
    for fd in (0, 1, 2):
        os.set_inheritable(fd, True)
    os.closerange(3, os.sysconf("SC_OPEN_MAX"))
    if in_scope:
        unit = f"agent-wait-{os.getpid()}-{proc_start_time(os.getpid())}.scope"
        try:
            # systemd-run --scope execs in place, preserving PID, start time,
            # and the flock held on fds 1-2.
            os.execvp("systemd-run", [
                "systemd-run", "--user", "--scope", "--quiet", "--collect",
                f"--unit={unit}", f"--property=TimeoutStopSec={int(STOP_TIMEOUT)}s",
                "--", sys.executable, os.path.abspath(__file__),
                "--supervise", log, unit, "--", *command,
            ])
        except OSError as error:
            print(f"agent-wait: no scope, running in the caller's: {error}", file=sys.stderr)
    supervise(log, "", command)
    os._exit(0)


def wait(log, stall_seconds, max_seconds):
    log = os.path.abspath(log)
    job = read_job(log)
    if job is None:
        return err(f"no job for {log}", BAD_INPUT)
    try:
        fd = open_regular(log, os.O_RDONLY)
        info = os.fstat(fd)
        os.close(fd)
    except OSError as error:
        return err(f"bad log: {error}", BAD_INPUT)
    if job == "corrupt":
        return err(f"corrupt job record for {log}", FAILED)

    signature = (info.st_size, info.st_mtime_ns)
    # Stall age counts from the log's last change so repeated calls accumulate.
    # Later changes use the monotonic clock; a future mtime counts as "now".
    changed_at = time.monotonic() - max(0.0, time.time() - info.st_mtime)
    started = time.monotonic()

    def finish(code, state, hint):
        print("; ".join([
            f"agent-wait: {log} {state} after {time.monotonic() - started:.0f}s",
            f"log last changed {time.monotonic() - changed_at:.0f}s ago",
            f"last line: {last_line(log)!r}", hint,
        ]))
        return code

    while True:
        if not pid_matches(job):
            latest = read_job(log)
            status = latest["exit"] if isinstance(latest, dict) else None
            if status == 0:
                return finish(EXITED, "exited", "the job exited 0")
            hint = ("no exit status recorded; see the log, the job may still run"
                    if status is None else f"the job exited {status}")
            return finish(FAILED, "exited", hint)
        try:
            info = os.stat(log)
            if stat.S_ISREG(info.st_mode) and (info.st_size, info.st_mtime_ns) != signature:
                signature, changed_at = (info.st_size, info.st_mtime_ns), time.monotonic()
        except OSError:
            pass  # A deleted log shows no progress.
        if time.monotonic() - changed_at >= stall_seconds:
            return finish(STALLED, "stalled", "report it with the job's state")
        if time.monotonic() - started >= max_seconds:
            return finish(RUNNING, "still running", "call agent-wait wait again")
        time.sleep(1)


def stop(log):
    log = os.path.abspath(log)
    job = read_job(log)
    if job is None:
        return err(f"no job for {log}", BAD_INPUT)
    if job == "corrupt":
        return err(f"corrupt job record for {log}", FAILED)

    same_boot = job["boot_id"] == boot_id()
    pid, st = job["pid"], job["start_time"]
    unit = job["unit"] if valid_unit(job) else ""
    pid_alive = same_boot and proc_start_time(pid) == st
    scope_alive = same_boot and bool(unit) and unit_active(unit)

    if not pid_alive and not scope_alive:
        detail = f"exit {job['exit']}" if job["exit"] is not None else "status unknown"
        print(f"agent-wait: {log} already exited ({detail})")
        return EXITED

    if scope_alive:
        try:
            subprocess.run(["systemctl", "--user", "stop", unit],
                           stdin=subprocess.DEVNULL, capture_output=True, timeout=STOP_TIMEOUT + 10)
        except (OSError, subprocess.TimeoutExpired):
            try:
                subprocess.run(["systemctl", "--user", "kill", "--kill-who=all", "-s", "SIGKILL", unit],
                               stdin=subprocess.DEVNULL, capture_output=True, timeout=5)
            except (OSError, subprocess.TimeoutExpired):
                pass
        if not wait_until(lambda: not unit_active(unit) and proc_start_time(pid) != st, 2):
            return err(f"could not stop scope {unit} for {log}", FAILED)
        print(f"agent-wait: stopped {log}")
        return EXITED

    # Fallback without a systemd scope: signal the supervisor's process group
    # only after verifying its identity.
    def still_up():
        cur = proc_start_time(pid)
        return cur == st or (cur is None and pgrp_has_live(pid))

    for sig, wait_secs in ((signal.SIGTERM, STOP_TIMEOUT), (signal.SIGKILL, 2)):
        try:
            os.killpg(pid, sig)
        except ProcessLookupError:
            pass
        except PermissionError as error:
            return err(f"could not stop {log}: {error}", FAILED)
        if wait_until(lambda: not still_up(), wait_secs):
            print(f"agent-wait: stopped {log}")
            return EXITED
    return err(f"could not stop {log}", FAILED)


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    # Internal: `start` re-runs itself with this inside its new scope.
    if argv[:1] == ["--supervise"]:
        if len(argv) < 5 or not argv[1] or argv[3] != "--":
            return err("--supervise needs LOG UNIT -- COMMAND [ARG ...]", BAD_INPUT)
        supervise(argv[1], argv[2], argv[4:])
        return EXITED

    parser = argparse.ArgumentParser(
        prog="agent-wait", usage=USAGE,
        description=__doc__.split("\n\n")[1].replace("\n", " "),
        epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="subcommand", required=True)

    p_start = sub.add_parser("start", usage="agent-wait start LOG -- COMMAND [ARG ...]",
                             help="start COMMAND detached; print the absolute log path")
    p_start.add_argument("log", help="the job's output file (also its handle)")

    p_wait = sub.add_parser("wait", help="wait for a started job in bounded steps")
    p_wait.add_argument("log", help="the job's log path")
    p_wait.add_argument("--stall-minutes", type=duration, default=15.0,
                        help="report a stall after LOG is unchanged this long (default 15)")
    p_wait.add_argument("--max-seconds", type=duration, default=540.0,
                        help="return 124 after this long if the job still runs (default 540)")

    p_stop = sub.add_parser("stop", help="stop a started job and all its descendants")
    p_stop.add_argument("log", help="the job's log path")

    # Split `start LOG -- CMD...` before argparse so misplaced flags before `--`
    # fail cleanly and `--` is never silently eaten as a flag terminator.
    command = []
    if argv[:1] == ["start"]:
        rest = argv[1:]
        search_from = 2 if rest[:1] == ["--"] else 0
        if "--" in rest[search_from:]:
            sep = rest.index("--", search_from)
            argv, command = ["start", *rest[:sep]], rest[sep + 1:]

    args = parser.parse_args(argv)
    if args.subcommand == "start":
        if not command:
            p_start.error("start needs LOG -- COMMAND [ARG ...]")
        return start(args.log, command)
    if args.subcommand == "wait":
        return wait(args.log, args.stall_minutes * 60, args.max_seconds)
    return stop(args.log)


if __name__ == "__main__":
    sys.exit(main())
