#!/usr/bin/env python3
"""Start a long job detached, then wait for it in bounded steps and notice hangs.

--start runs the job under a small supervisor in a new session, so it survives
the agent's shell, and prints the supervisor's PID. The supervisor records the
job's exit status in LOG.exit. --pid waits on that PID for at most
--max-seconds and calls a log unchanged for --stall-minutes a stall. Linux only.
"""

import argparse
import math
import os
import stat
import subprocess
import sys
import time

EXITED, BAD_INPUT, STALLED, FAILED, RUNNING = 0, 2, 3, 4, 124

EPILOG = """\
exit codes:
  0    started (--start), or the job exited 0, or it has no LOG.exit
  2    bad input: arguments, no such process or LOG.exit, or a non-regular log
  3    stalled: the log hasn't changed for --stall-minutes; report it
  4    the job exited nonzero or its status is unknown (not 1: a crash's code)
  124  still running after --max-seconds; call again

To stop a job, kill its process group (kill -- -PID). Killing only the PID
leaves the job running, and --pid then exits 4.

Limits: stall age carries across calls only through the log's mtime, so a
future mtime restarts the count, and a log deleted between calls gives 2.
"""


def duration(text):
    value = float(text)
    if not math.isfinite(value) or value < 0:
        raise argparse.ArgumentTypeError(f"must be a finite number >= 0: {text!r}")
    return value


def open_regular(path, flags):
    """Open nonblocking, so a FIFO can't hang us; check the type on the descriptor."""
    fd = os.open(path, flags | os.O_NONBLOCK | os.O_CLOEXEC, 0o644)
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        raise OSError(f"not a regular file: {path}")
    os.set_blocking(fd, True)
    return fd


def write_status(log, value):
    """Write LOG.exit through a rename, so a reader never sees half of it."""
    with open(log + ".exit.tmp", "w") as f:
        f.write(f"{value}\n")
    os.replace(log + ".exit.tmp", log + ".exit")


def read_status(log):
    """Return the job's exit status, None if there's no LOG.exit, or "unknown"."""
    try:
        with open(log + ".exit") as f:
            return int(f.read())
    except FileNotFoundError:
        return None
    except (OSError, ValueError):  # "pending", garbage, bad UTF-8
        return "unknown"


def start_time(pid):
    """Return the process's start time (to catch PID reuse), or None if it's gone or a zombie."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            text = f.read()
    except OSError:
        return None
    # The command name may contain spaces and parentheses. The fields after it
    # start with the state (field 3); field 22 is the start time.
    fields = text[text.rindex(")") + 2 :].split()
    return None if fields[0] in ("Z", "X") else fields[19]


def last_line(path):
    try:
        with os.fdopen(open_regular(path, os.O_RDONLY), "rb") as f:
            f.seek(max(0, os.fstat(f.fileno()).st_size - 4096))
            lines = f.read().decode(errors="replace").split("\n")
    except OSError:
        return ""
    return next((line.strip()[-200:] for line in reversed(lines) if line.strip()), "")


def start(log, command):
    try:
        log_fd = open_regular(log, os.O_WRONLY | os.O_APPEND | os.O_CREAT)
        # Replaces a status from an earlier run. A supervisor that dies before
        # replacing it leaves "pending", which the waiter reports as unknown.
        write_status(log, "pending")
    except OSError as error:
        print(f"agent-wait: {error}", file=sys.stderr)
        return BAD_INPUT
    sys.stdout.flush()
    pid = os.fork()
    if pid:
        print(pid)
        return EXITED
    # The supervisor. A new session survives the harness killing the calling
    # shell's process group. Pointing 0-2 away from the harness's pipes and
    # closing the rest lets the tool call return at once.
    os.setsid()
    os.dup2(os.open(os.devnull, os.O_RDONLY), 0)
    os.dup2(log_fd, 1)
    os.dup2(log_fd, 2)
    os.closerange(3, os.sysconf("SC_OPEN_MAX"))
    try:
        returncode = subprocess.call(command)
        write_status(log, 128 - returncode if returncode < 0 else returncode)
    except OSError as error:
        # An unknown command, or LOG.exit can't be written: it stays "pending",
        # which the waiter reports as unknown, never as success.
        print(f"agent-wait: {error}", file=sys.stderr)
    os._exit(0)


def wait(pid, log, stall_seconds, max_seconds):
    identity = start_time(pid)
    # A job that ended before this call still has its LOG.exit.
    if identity is None and (not log or read_status(log) is None):
        print(f"agent-wait: no running process with pid {pid}", file=sys.stderr)
        return BAD_INPUT
    if log:
        try:
            os.close(open_regular(log, os.O_RDONLY))
        except OSError as error:
            print(f"agent-wait: bad log: {error}", file=sys.stderr)
            return BAD_INPUT
        info = os.stat(log)
        signature = (info.st_size, info.st_mtime_ns)
        # Stall age counts from the log's last change, so repeated calls keep
        # counting. Later changes use the monotonic clock; a future mtime is "now".
        changed_at = time.monotonic() - max(0.0, time.time() - info.st_mtime)
    started = time.monotonic()

    def finish(code, state, hint):
        parts = [f"agent-wait: pid {pid} {state} after {time.monotonic() - started:.0f}s"]
        if log:
            parts.append(f"log last changed {time.monotonic() - changed_at:.0f}s ago")
            parts.append(f"last line: {last_line(log)!r}")
        print("; ".join(parts + [hint]))
        return code

    while True:
        if identity is None or start_time(pid) != identity:
            status = read_status(log) if log else None
            hints = {None: "no LOG.exit; check the job's own result", 0: "the job exited 0",
                     "unknown": "no exit status recorded; see the log, the job may still run"}
            return finish(EXITED if status in (None, 0) else FAILED, "exited",
                          hints.get(status, f"the job exited {status}"))
        if log:
            try:
                info = os.stat(log)
                if stat.S_ISREG(info.st_mode) and (info.st_size, info.st_mtime_ns) != signature:
                    signature, changed_at = (info.st_size, info.st_mtime_ns), time.monotonic()
            except OSError:
                pass  # A deleted log shows no progress.
            if time.monotonic() - changed_at >= stall_seconds:
                return finish(STALLED, "stalled", "report it with the job's state")
        if time.monotonic() - started >= max_seconds:
            return finish(RUNNING, "still running", "call agent-wait again")
        time.sleep(1)


def main():
    parser = argparse.ArgumentParser(
        description=__doc__.split("\n\n")[1].replace("\n", " "),
        usage="agent-wait --start --log LOG -- COMMAND [ARG ...]\n"
              "       agent-wait --pid PID [--log LOG] [--stall-minutes M] [--max-seconds S]",
        epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--start", action="store_true", help="start COMMAND detached; print a PID")
    mode.add_argument("--pid", type=int, help="the PID --start printed, or any job's PID")
    parser.add_argument("--log", help="the job's output file; enables stall detection and exit status")
    parser.add_argument("--stall-minutes", type=duration, default=15.0,
                        help="report a stall after the log is unchanged this long (default 15)")
    parser.add_argument("--max-seconds", type=duration, default=540.0,
                        help="return 124 after this long if the job still runs (default 540)")
    parser.add_argument("command", nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if args.start:
        if not args.log or not command:
            parser.error("--start needs --log LOG and a command after --")
        return start(args.log, command)
    if command:
        parser.error("a command is only allowed with --start")
    return wait(args.pid, args.log, args.stall_minutes * 60, args.max_seconds)


if __name__ == "__main__":
    sys.exit(main())
