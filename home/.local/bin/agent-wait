#!/usr/bin/env python3
"""Start a long job detached, wait for it in bounded steps, or stop it.

The log file is the only handle. `start` runs the job under a small supervisor
in a new session and, when a systemd user manager answers, in its own named
transient scope so it survives the caller's shell and session restarts. It
prints the resolved absolute log path and stores the job's identity and exit
status in LOG.job. `wait` blocks up to --max-seconds and reports a stall when
LOG stops changing for --stall-minutes. `stop` terminates the job's scope, or
its process group without systemd. Linux only.
"""

import argparse
from contextlib import suppress
import fcntl
import json
import math
import os
import signal
import socket
import stat
import subprocess
import sys
import time

EXITED, BAD_INPUT, STALLED, FAILED, RUNNING = 0, 2, 3, 4, 124
START_TIMEOUT, STOP_TIMEOUT, JOB_SUFFIX = 10.0, 5.0, ".job"

USAGE = """\
agent-wait start LOG -- COMMAND [ARG ...]
       agent-wait wait LOG [--stall-minutes M] [--max-seconds S]
       agent-wait stop LOG"""

EPILOG = """\
wait options:
  --stall-minutes M  stall timeout on unchanged LOG (default 15)
  --max-seconds S    return 124 after this long if still running (default 540)

exit codes:
  start: 0 started | 2 bad input or job already running on LOG | 4 launch failed
  wait:  0 job exited 0 | 2 bad input or no job | 3 stalled | 4 failed, stopped, or unknown | 124 still running
  stop:  0 stopped or already ended | 2 bad input or no job | 4 could not stop
  (1 is reserved for crashes)

Limits: stall age carries across calls only through the log's mtime, so a
future mtime restarts the count, a log deleted between calls gives 2, and
deleting LOG.job while a job runs is unsupported and can corrupt a replacement's record.
"""

with open("/proc/sys/kernel/random/boot_id") as _f:
    BOOT_ID = _f.read().strip()


def err(message, code):
    print(f"agent-wait: {message}", file=sys.stderr)
    return code


def duration(text):
    value = float(text)
    if not math.isfinite(value) or value < 0:
        raise argparse.ArgumentTypeError(f"must be a finite number >= 0: {text!r}")
    return value


def run_cmd(argv, timeout=5):
    try:
        return subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


def open_regular(path, flags):
    """Open nonblocking so a FIFO can't hang us; verify the descriptor is regular."""
    fd = os.open(path, flags | os.O_NONBLOCK | os.O_CLOEXEC, 0o644)
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        raise OSError(f"not a regular file: {path}")
    os.set_blocking(fd, True)
    return fd


def write_json(path, data):
    """Write a sidecar through a rename so readers never see a partial write."""
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w") as f:
            f.write(json.dumps(data) + "\n")
        os.replace(tmp, path)
    except BaseException:
        with suppress(OSError):
            os.unlink(tmp)
        raise


def read_job(log):
    """Return a validated job record, None if missing, or 'corrupt' if malformed."""
    try:
        with os.fdopen(open_regular(log + JOB_SUFFIX, os.O_RDONLY)) as f:
            data = json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        return "corrupt"
    if isinstance(data, dict):
        pid, st, bid, unit, code = (data.get(k) for k in ("pid", "start_time", "boot_id", "unit", "exit"))
        if (type(pid) is int and pid > 0 and isinstance(st, str) and st
                and isinstance(bid, str) and bid and isinstance(unit, str)
                and (code is None or type(code) is int)):
            return {"pid": pid, "start_time": st, "boot_id": bid, "unit": unit, "exit": code}
    return "corrupt"


def same_job(a, b):
    return (isinstance(a, dict) and isinstance(b, dict)
            and (a["pid"], a["start_time"], a["boot_id"]) == (b["pid"], b["start_time"], b["boot_id"]))


def proc_stat(pid):
    """Return (state, pgrp, start_time) from /proc/PID/stat, or None if gone."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            text = f.read()
        # Comm may contain spaces and parens; fields after it start at field 3 (state).
        fields = text[text.rindex(")") + 2:].split()
        return fields[0], int(fields[2]), fields[19]
    except (OSError, ValueError, IndexError):
        return None


def proc_start_time(pid):
    info = proc_stat(pid)
    return None if info is None or info[0] in ("Z", "X") else info[2]


def expected_unit(job):
    """Return the scope unit name only when it matches this job's PID and start time."""
    unit = f"agent-wait-{job['pid']}-{job['start_time']}.scope"
    return unit if job["unit"] == unit else ""


def unit_active(unit):
    res = run_cmd(["systemctl", "--user", "show", "-p", "ActiveState", "--value", unit])
    return bool(res and res.returncode == 0 and res.stdout.strip() in ("active", "activating", "reloading", "deactivating"))


def pgrp_has_live(pgid):
    """True if any non-zombie process still belongs to process group pgid."""
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return any((i := proc_stat(n)) and i[0] not in ("Z", "X") and i[1] == pgid for n in os.listdir("/proc") if n.isdigit())


def wait_until(done, seconds, step=0.05):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if done():
            return True
        time.sleep(step)
    return done()


def last_line(path):
    try:
        with os.fdopen(open_regular(path, os.O_RDONLY), "rb") as f:
            f.seek(max(0, os.fstat(f.fileno()).st_size - 4096))
            lines = f.read().decode(errors="replace").split("\n")
    except OSError:
        return ""
    return next((line.strip()[-200:] for line in reversed(lines) if line.strip()), "")


def job_running(job):
    if not isinstance(job, dict) or job["boot_id"] != BOOT_ID:
        return False
    unit = expected_unit(job)
    return proc_start_time(job["pid"]) == job["start_time"] or (bool(unit) and unit_active(unit))


def load_job(log):
    job = read_job(log)
    if job is None:
        return err(f"no job for {log}", BAD_INPUT)
    return err(f"corrupt job record for {log}", FAILED) if job == "corrupt" else job


def supervise(log, unit, command):
    """Record identity, await parent's go-ahead on fd 3, run job, and store exit."""
    record = {"pid": os.getpid(), "start_time": proc_start_time(os.getpid()),
              "boot_id": BOOT_ID, "unit": unit, "exit": None}
    wrote, go = False, b""
    try:
        with socket.socket(fileno=3) as sock:
            # BlockingIOError means parent is still waiting; EOF means it aborted.
            try:
                sock.recv(1, socket.MSG_PEEK | socket.MSG_DONTWAIT)
                return FAILED
            except BlockingIOError:
                pass
            try:
                write_json(log + JOB_SUFFIX, record)
                wrote = True
            except OSError as error:
                sock.sendall(b"B" + str(error).encode()[:200])
                return FAILED
            sock.sendall(b"R")
            go = sock.recv(1)
    except OSError:
        with suppress(OSError):
            os.close(3)
    if go != b"G":
        if wrote and same_job(read_job(log), record):
            with suppress(OSError):
                os.unlink(log + JOB_SUFFIX)
        return FAILED
    try:
        rc = subprocess.call(command)
        record["exit"] = 128 - rc if rc < 0 else rc
        # Don't clobber a replacement job if LOG and LOG.job were deleted mid-run.
        if same_job(read_job(log), record):
            write_json(log + JOB_SUFFIX, record)
    except OSError as error:
        print(f"agent-wait: {error}", file=sys.stderr)
    return EXITED


def start(log, command):
    busy = f"job already running on {log}; wait or stop it first"
    if job_running(read_job(log)):
        return err(busy, BAD_INPUT)
    try:
        log_fd = open_regular(log, os.O_WRONLY | os.O_APPEND | os.O_CREAT)
    except OSError as error:
        return err(error, BAD_INPUT)
    try:
        try:
            # Held on log_fd and inherited on fds 1-2 across fork and systemd-run
            # --scope so concurrent starts serialize and a running job blocks reuse.
            fcntl.flock(log_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return err(busy, BAD_INPUT)
        if job_running(read_job(log)):
            return err(busy, BAD_INPUT)

        # Probed before forking: once the child execs systemd-run, a failure can't fall back.
        probe = run_cmd(["systemd-run", "--user", "--scope", "--quiet", "--collect",
                         f"--property=TimeoutStopSec={int(STOP_TIMEOUT)}s", "true"], timeout=10)
        in_scope = bool(probe and probe.returncode == 0)
        parent_sock, child_sock = socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM)
        with suppress(AttributeError, OSError):
            sys.stdout.flush()
        pid = os.fork()
        if pid:
            child_sock.close()
            child_id = {"pid": pid, "start_time": (proc_stat(pid) or ("", 0, ""))[2], "boot_id": BOOT_ID}
            reply, committed = b"", False
            try:
                parent_sock.settimeout(START_TIMEOUT)
                reply = parent_sock.recv(256)
                if reply == b"R":
                    # Truncate and refresh mtime after supervise wrote LOG.job and
                    # before 'G', so wait never sees a stale log or mtime.
                    os.ftruncate(log_fd, 0)
                    os.utime(log_fd, None)
                    parent_sock.sendall(b"G")
                    committed = True
            except OSError:
                reply = b""
            finally:
                parent_sock.close()
            if committed:
                # Committed: a stdout error (e.g. /dev/full) must not abort or unlink LOG.job.
                # With stdout closed, open() may have put the log on fd 1; the path
                # must not land in the job's own log. fsencode: Linux paths are bytes.
                if log_fd != 1:
                    with suppress(OSError):
                        os.write(1, os.fsencode(log) + b"\n")
                return EXITED
            # Abort: socket is closed so the child cannot commit even if it wakes later.
            def reaped():
                with suppress(ChildProcessError):
                    return os.waitpid(pid, os.WNOHANG)[0] == pid
                return True
            if not wait_until(reaped, 0.2, step=0.02):
                with suppress(ProcessLookupError):
                    os.kill(pid, signal.SIGKILL)
                wait_until(reaped, 0.5, step=0.02)
            if child_id["start_time"] and same_job(read_job(log), child_id):
                with suppress(OSError):
                    os.unlink(log + JOB_SUFFIX)
            if reply.startswith(b"B"):
                return err(reply[1:].decode(errors="replace") or f"cannot write {log}{JOB_SUFFIX}", BAD_INPUT)
            return err(f"supervisor failed to start; see {log}", FAILED)
    finally:
        if "pid" not in locals() or pid:
            os.close(log_fd)

    # Supervisor: new session survives harness process-group kills; move both
    # fds above 0-3 first so dup2 onto 0-3 can't clobber them when stdio is closed.
    parent_sock.close()
    os.setsid()
    log_fd = fcntl.fcntl(log_fd, fcntl.F_DUPFD, 4)
    cs_fd = fcntl.fcntl(child_sock.fileno(), fcntl.F_DUPFD, 4)
    for dst, src in ((1, log_fd), (2, log_fd), (0, os.open(os.devnull, os.O_RDONLY)), (3, cs_fd)):
        os.dup2(src, dst)
        os.set_inheritable(dst, True)
    os.closerange(4, os.sysconf("SC_OPEN_MAX"))
    if in_scope:
        unit = f"agent-wait-{os.getpid()}-{proc_start_time(os.getpid())}.scope"
        try:
            # systemd-run --scope execs in place, preserving PID, start time,
            # the flock on fds 1-2, and the handshake socket on fd 3.
            os.execvp("systemd-run", [
                "systemd-run", "--user", "--scope", "--quiet", "--collect",
                f"--unit={unit}", f"--property=TimeoutStopSec={int(STOP_TIMEOUT)}s",
                "--", sys.executable, os.path.abspath(__file__),
                "--supervise", log, unit, "--", *command,
            ])
        except OSError as error:
            print(f"agent-wait: no scope, running in the caller's: {error}", file=sys.stderr)
    supervise(log, "", command)
    os._exit(0)


def wait(log, stall_seconds, max_seconds):
    try:
        with os.fdopen(open_regular(log, os.O_RDONLY), "rb") as f:
            info = os.fstat(f.fileno())
    except OSError as error:
        return err(f"bad log: {error}", BAD_INPUT)
    job = load_job(log)
    if isinstance(job, int):
        return job

    sig = (info.st_size, info.st_mtime_ns)
    changed_at = time.monotonic() - max(0.0, time.time() - info.st_mtime)
    started = time.monotonic()

    def finish(code, state, hint):
        print(f"agent-wait: {log} {state} after {time.monotonic() - started:.0f}s; "
              f"log last changed {time.monotonic() - changed_at:.0f}s ago; "
              f"last line: {last_line(log)!r}; {hint}")
        return code

    while True:
        if job["boot_id"] != BOOT_ID or proc_start_time(job["pid"]) != job["start_time"]:
            latest = read_job(log)
            if not same_job(latest, job):
                reason = ("log was reused for another job; original exit status unknown"
                          if isinstance(latest, dict) else "job record missing or unreadable")
                return finish(FAILED, "exited", reason)
            status = latest["exit"]
            if status == 0:
                return finish(EXITED, "exited", "the job exited 0")
            # No record means the supervisor died first. `stop` kills the whole
            # scope, but a kill aimed at the supervisor alone can leave the job running.
            hint = ("no exit status recorded: stopped or killed; unless `agent-wait stop` "
                    "did it, the job may still run" if status is None else f"the job exited {status}")
            return finish(FAILED, "exited", hint)
        with suppress(OSError):
            info = os.stat(log)
            if stat.S_ISREG(info.st_mode) and (info.st_size, info.st_mtime_ns) != sig:
                sig, changed_at = (info.st_size, info.st_mtime_ns), time.monotonic()
        if time.monotonic() - changed_at >= stall_seconds:
            return finish(STALLED, "stalled", "report it with the job's state")
        if time.monotonic() - started >= max_seconds:
            return finish(RUNNING, "still running", "call agent-wait wait again")
        time.sleep(1)


def stop(log):
    job = load_job(log)
    if isinstance(job, int):
        return job

    same_boot = job["boot_id"] == BOOT_ID
    pid, st, unit = job["pid"], job["start_time"], expected_unit(job)
    info = proc_stat(pid) if same_boot else None
    pid_alive = info is not None and info[0] not in ("Z", "X") and info[2] == st
    zombie_pgrp = info is not None and info[0] in ("Z", "X") and info[2] == st and pgrp_has_live(pid)
    scope_alive = same_boot and bool(unit) and unit_active(unit)

    def report_ended(record):
        detail = f"exit {record['exit']}" if record["exit"] is not None else "status unknown"
        print(f"agent-wait: {log} already exited ({detail})")
        return EXITED

    if not pid_alive and not zombie_pgrp and not scope_alive:
        if same_boot and not unit and info is None and job["exit"] is None and pgrp_has_live(pid):
            return err(f"supervisor gone, but process group {pid} still has live processes for {log}", FAILED)
        return report_ended(job)

    if scope_alive:
        res = run_cmd(["systemctl", "--user", "stop", unit], timeout=STOP_TIMEOUT + 10)
        stopped = wait_until(lambda: not unit_active(unit) and proc_start_time(pid) != st, 2)
        if stopped and res is not None and res.returncode == 0:
            print(f"agent-wait: stopped {log}")
            return EXITED
        if stopped:
            latest = read_job(log)
            return report_ended(latest if same_job(latest, job) else job)
        return err(f"could not stop scope {unit} for {log}", FAILED)

    # Fallback without a systemd scope: signal the verified process group.
    still_up = lambda: (cur := proc_start_time(pid)) == st or (cur is None and pgrp_has_live(pid))
    for sig, wait_secs in ((signal.SIGTERM, STOP_TIMEOUT), (signal.SIGKILL, 2)):
        try:
            os.killpg(pid, sig)
        except ProcessLookupError:
            pass
        except PermissionError as error:
            return err(f"could not stop {log}: {error}", FAILED)
        if wait_until(lambda: not still_up(), wait_secs):
            print(f"agent-wait: stopped {log}")
            return EXITED
    return err(f"could not stop {log}", FAILED)


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv[:1] == ["--supervise"]:
        if len(argv) < 5 or not argv[1] or argv[3] != "--":
            return err("--supervise needs LOG UNIT -- COMMAND [ARG ...]", BAD_INPUT)
        return supervise(argv[1], argv[2], argv[4:])

    parser = argparse.ArgumentParser(
        prog="agent-wait", usage=USAGE, description=__doc__.split("\n\n")[1].replace("\n", " "),
        epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="subcommand", required=True)
    p_start = sub.add_parser("start", usage="agent-wait start LOG -- COMMAND [ARG ...]",
                             help="start COMMAND detached; print the absolute log path")
    p_wait = sub.add_parser("wait", help="wait for a started job in bounded steps")
    p_wait.add_argument("--stall-minutes", type=duration, default=15.0)
    p_wait.add_argument("--max-seconds", type=duration, default=540.0)
    p_stop = sub.add_parser("stop", help="stop a started job (its scope, or its process group without systemd)")
    for p in (p_start, p_wait, p_stop):
        p.add_argument("log")

    # Split `start LOG -- CMD...` before argparse so misplaced flags before `--`
    # fail cleanly and `--` is never silently eaten as a flag terminator.
    command = []
    if argv[:1] == ["start"]:
        rest = argv[1:]
        search_from = 2 if rest[:1] == ["--"] else 0
        if "--" in rest[search_from:]:
            sep = rest.index("--", search_from)
            argv, command = ["start", *rest[:sep]], rest[sep + 1:]

    args = parser.parse_args(argv)
    log = os.path.abspath(args.log)
    if log.endswith(JOB_SUFFIX) or os.path.realpath(log).endswith(JOB_SUFFIX):
        return err(f"log path must not end in {JOB_SUFFIX}: {log}", BAD_INPUT)
    if args.subcommand == "start":
        if not command:
            p_start.error("start needs LOG -- COMMAND [ARG ...]")
        return start(log, command)
    if args.subcommand == "wait":
        return wait(log, args.stall_minutes * 60, args.max_seconds)
    return stop(log)


if __name__ == "__main__":
    sys.exit(main())
