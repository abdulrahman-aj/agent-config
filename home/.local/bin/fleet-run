#!/usr/bin/env python3
"""Run a command on a fleet machine over Tailscale SSH, with its arguments intact.

The command reaches the remote as a bash script on stdin, so the remote login
shell (fish on this fleet) only ever parses `bash -l -s`, and every argument
arrives exactly as given: spaces, quotes, $ and newlines included. bash -l gives
the login PATH (~/.local/bin, Nix); mise shims are added when present.
"""

import argparse
import json
import os
import shlex
import subprocess
import sys

EPILOG = """\
The exit status is the remote command's (255: SSH failed). stdin isn't
forwarded. HOST may be USER@HOST; the user defaults to $FLEET_USER, then $USER.

Long jobs: start them detached with agent-wait on the remote side, then wait in
bounded steps, also on the remote side:
  fleet-run msi-dux -- agent-wait --start --log LOG -- COMMAND [ARG ...]
  fleet-run msi-dux -- agent-wait --pid PID --log LOG   # repeat while it exits 124
Inside a T3 thread, fleet-run records the remote job, and Claude Code's
agent-guard hook keeps the turn going until a wait returns something but 124.
"""

PRELUDE = 'if [ -d "$HOME/.local/share/mise/shims" ]; then PATH="$HOME/.local/share/mise/shims:$PATH"; fi\n'
RUNNING = 124


def option(command, name):
    """Return the value of --name VALUE or --name=VALUE in an agent-wait argv."""
    for i, arg in enumerate(command):
        if arg == "--":
            break
        if arg == name and i + 1 < len(command):
            return command[i + 1]
        if arg.startswith(name + "="):
            return arg.split("=", 1)[1]
    return None


def job_record(host, pid):
    state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(state, "agent-jobs", f"{host.replace('/', '_')}-{pid}.json")


def record_job(host, pid, log):
    owner = os.environ.get("T3CODE_THREAD_ID")
    if not owner:
        return  # agent-guard only guards T3 threads.
    wait = ["fleet-run", host, "--", "agent-wait", "--pid", str(pid)]
    if log:
        wait += ["--log", log]
    path = job_record(host, pid)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
        json.dump({"owner": owner, "wait": shlex.join(wait)}, f)
    os.replace(path + ".tmp", path)


def main():
    parser = argparse.ArgumentParser(
        description=__doc__.split("\n\n")[0],
        usage="fleet-run HOST -- COMMAND [ARG ...]",
        epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("host")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        parser.error("a command is required after --")
    destination = args.host if "@" in args.host else \
        f"{os.environ.get('FLEET_USER') or os.environ['USER']}@{args.host}"
    script = PRELUDE + "exec " + shlex.join(command) + "\n"
    ssh = ["tailscale", "ssh", destination, "bash -l -s"]

    starts_job = command[0] == "agent-wait" and "--start" in command
    if not starts_job:
        code = subprocess.run(ssh, input=script.encode()).returncode
        if command[0] == "agent-wait" and code != RUNNING:
            pid = option(command, "--pid")
            if pid:
                try:
                    os.remove(job_record(args.host, pid))
                except FileNotFoundError:
                    pass
        return code

    # Capture the PID agent-wait prints so the job can be recorded.
    result = subprocess.run(ssh, input=script.encode(), stdout=subprocess.PIPE)
    sys.stdout.buffer.write(result.stdout)
    lines = result.stdout.decode(errors="replace").split()
    if result.returncode == 0 and lines and lines[-1].isdigit():
        record_job(args.host, lines[-1], option(command, "--log"))
    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
