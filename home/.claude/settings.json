{
  "theme": "dark",
  "autoCompactWindow": 400000,
  "promptCacheTtl": "1h",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/leak-check --claude-hook"
          }
        ]
      }
    ]
  }
}
